<%- include('partials/header', { title: 'Ferramentas', paginaAtiva: 'dashboard' }) %>

<header class="header">
    <h1 class="header-title">Controle de Ferramentas</h1>
    
    <div class="header-right">
        <div class="user-profile">
            <span>Bem-vindo, João</span>
            <img src="https://i.pravatar.cc/40?u=joao" alt="Avatar">
        </div>
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Ferramentas Disponíveis para Retirada</h2>
        <a href="/historico" class="btn-secondary">
            <i class="bi bi-clock-history"></i> Ver Histórico
        </a>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Nome da Ferramenta</th>
                    <th style="width: 150px; text-align: center;">Ação</th>
                </tr>
            </thead>
            <tbody>
                <% if (disponiveis.length > 0) { %>
                    <% disponiveis.forEach(ferramenta => { %>
                        <tr>
                            <td><strong><%= ferramenta.nome %></strong></td>
                            <td style="text-align: center;">
                                <button class="btn-retirar" data-id="<%= ferramenta.id %>" data-nome="<%= ferramenta.nome %>">
                                    <i class="bi bi-box-arrow-up-right"></i> Retirar
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="2" style="text-align: center;">Nenhuma ferramenta disponível no momento.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>

    <div class="main-header" style="margin-top: 40px;">
        <h2>Ferramentas em Uso (Retiradas)</h2>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Ferramenta</th>
                    <th>Retirado por</th>
                    <th>Data e Hora da Retirada</th>
                    <th style="width: 150px; text-align: center;">Ação</th>
                </tr>
            </thead>
            <tbody>
                 <% if (retiradas.length > 0) { %>
                    <% retiradas.forEach(ferramenta => { %>
                        <tr>
                            <td><strong><%= ferramenta.nome %></strong></td>
                            <td><%= ferramenta.retiradoPor %></td>
                            <td><%= new Date(ferramenta.dataRetirada).toLocaleString('pt-BR') %></td>
                            <td style="text-align: center;">
                                <form action="/ferramentas/devolver/<%= ferramenta.id %>" method="POST" style="margin:0;">
                                    <button type="submit" class="btn-devolver">
                                        <i class="bi bi-box-arrow-in-down-left"></i> Devolver
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="4" style="text-align: center;">Nenhuma ferramenta em uso no momento.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<div class="modal-overlay" id="retirar-modal">
    <div class="modal" style="max-width: 500px;">
        <div class="modal-header">
            <h3 id="modal-title">Retirar Ferramenta</h3>
            <button class="close-button" id="btn-close-modal">&times;</button>
        </div>
        <form id="retirar-form" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label for="nome">Nome do Responsável pela Retirada:</label>
                    <input type="text" id="nome" name="nome" required autocomplete="off">
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn-primary">Confirmar Retirada</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('retirar-modal');
    const modalTitle = document.getElementById('modal-title');
    const retirarForm = document.getElementById('retirar-form');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnsRetirar = document.querySelectorAll('.btn-retirar');

    btnsRetirar.forEach(btn => {
        btn.addEventListener('click', () => {
            const ferramentaId = btn.dataset.id;
            const ferramentaNome = btn.dataset.nome;

            // Atualiza o título e a ação do formulário do modal
            modalTitle.innerText = `Retirar: ${ferramentaNome}`;
            retirarForm.action = `/ferramentas/retirar/${ferramentaId}`;
            
            // Exibe o modal
            modal.style.display = 'flex';
        });
    });

    if (btnCloseModal) {
        btnCloseModal.addEventListener('click', () => {
            modal.style.display = 'none';
        });
    }

    window.addEventListener('click', (event) => {
        if (event.target === modal) {
            modal.style.display = 'none';
        }
    });
});
</script>