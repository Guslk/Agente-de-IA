<%- include('partials/header', { title: 'Dashboard', paginaAtiva: 'dashboard' }) %>

<header class="header">
    <h1 class="header-title">Controle de Ferramentas</h1>
    <div class="user-profile">
        <span>Bem-vindo, João</span>
        <img src="https://i.pravatar.cc/40?u=joao" alt="Avatar do Usuário">
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Ferramentas Disponíveis para Retirada</h2>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Nome da Ferramenta</th>
                    <th style="width: 150px; text-align: center;">Ação</th>
                </tr>
            </thead>
            <tbody>
                <% if (disponiveis.length > 0) { %>
                    <% disponiveis.forEach(ferramenta => { %>
                        <tr>
                            <td><strong><%= ferramenta.nome %></strong></td>
                            <td style="text-align: center;">
                                <button class="btn-retirar">
                                    <i class="bi bi-box-arrow-up-right"></i> Retirar
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="2" style="text-align: center;">Nenhuma ferramenta disponível no momento.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>

    <div class="main-header" style="margin-top: 40px;">
        <h2>Ferramentas em Uso (Retiradas)</h2>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Ferramenta</th>
                    <th>Retirado por</th>
                    <th>Data e Hora da Retirada</th>
                    <th style="width: 150px; text-align: center;">Ação</th>
                </tr>
            </thead>
            <tbody>
                 <% if (retiradas.length > 0) { %>
                    <% retiradas.forEach(ferramenta => { %>
                        <tr>
                            <td><strong><%= ferramenta.nome %></strong></td>
                            <td><%= ferramenta.retiradoPor %></td>
                            <td>
                                <%= new Date(ferramenta.dataRetirada).toLocaleString('pt-BR') %>
                            </td>
                            <td style="text-align: center;">
                                <button class="btn-devolver">
                                    <i class="bi bi-box-arrow-in-down-left"></i> Devolver
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center;">Nenhuma ferramenta em uso no momento.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<%- include('partials/footer') %>