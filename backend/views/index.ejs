<%- include('partials/header', { title: 'Ferramentas', paginaAtiva: 'ferramentas' }) %>

<header class="header">
    <h1 class="header-title">Controle de Ferramentas</h1>
    
    <div class="header-right">
        <div class="notification-icon">
            <i class="bi bi-bell-fill"></i>
            <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
                <span class="notification-badge"><%= lowStockCount %></span>
            <% } %>
        </div>
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.nome %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar">
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Ferramentas Disponíveis</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-show-add-ferramenta-modal"><i class="bi bi-plus-circle-fill"></i> Nova Ferramenta</button>
            <a href="/historico" class="btn-secondary">
                <i class="bi bi-clock-history"></i> Ver Histórico
            </a>
        </div>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome da Ferramenta</th>
                    <th style="width: 150px; text-align: center;">Ação</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof disponiveis !== 'undefined' && disponiveis.length > 0) { %>
                    <% disponiveis.forEach(ferramenta => { %>
                        <tr>
                            <td><code><%= ferramenta.codigo %></code></td>
                            <td><strong><%= ferramenta.nome %></strong></td>
                            <td style="text-align: center;">
                                <button class="btn-retirar" data-id="<%= ferramenta.id %>" data-nome="<%= ferramenta.nome %>">
                                    <i class="bi bi-box-arrow-up-right"></i> Retirar
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="3" style="text-align: center;">Nenhuma ferramenta disponível no momento.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>

    <div class="main-header" style="margin-top: 40px;">
        <h2>Ferramentas em Uso (Retiradas)</h2>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Ferramenta</th>
                    <th>Retirado por</th>
                    <th>Data e Hora da Retirada</th>
                    <th style="width: 150px; text-align: center;">Ação</th>
                </tr>
            </thead>
            <tbody>
                 <% if (typeof retiradas !== 'undefined' && retiradas.length > 0) { %>
                    <% retiradas.forEach(ferramenta => { %>
                        <tr>
                            <td><code><%= ferramenta.codigo %></code></td>
                            <td><strong><%= ferramenta.nome %></strong></td>
                            <td><%= ferramenta.retiradoPor %></td>
                            <td><%= new Date(ferramenta.dataRetirada).toLocaleString('pt-BR') %></td>
                            <td style="text-align: center;">
                                <form action="/ferramentas/devolver/<%= ferramenta.id %>" method="POST" style="margin:0;">
                                    <button type="submit" class="btn-devolver">
                                        <i class="bi bi-box-arrow-in-down-left"></i> Devolver
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="5" style="text-align: center;">Nenhuma ferramenta em uso no momento.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<div class="modal-overlay" id="retirar-modal">
    <div class="modal" style="max-width: 500px;">
        <div class="modal-header">
            <h3 id="modal-title">Retirar Ferramenta</h3>
            <button class="close-button" id="btn-close-modal">&times;</button>
        </div>
        <form id="retirar-form" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label for="retirar-responsavel">Responsável pela Retirada</label>
                    <select id="retirar-responsavel" name="nome" required>
                        <option value="" disabled selected>Selecione um funcionário...</option>
                        <% if (typeof funcionarios !== 'undefined' && funcionarios.length > 0) { %>
                            <% funcionarios.forEach(func => { %>
                                <option value="<%= func.nome %>"><%= func.nome %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn-primary">Confirmar Retirada</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="add-ferramenta-modal">
    <div class="modal" style="max-width: 500px;">
        <div class="modal-header">
            <h3>Cadastrar Nova Ferramenta</h3>
            <button class="close-button" id="btn-close-add-ferramenta-modal">&times;</button>
        </div>
        <form action="/ferramentas/nova" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label for="ferramenta-codigo">Código da Ferramenta</label>
                    <input type="text" id="ferramenta-codigo" name="codigo" required placeholder="Ex: FUR-BOS-01">
                </div>
                <div class="form-group">
                    <label for="ferramenta-nome">Nome da Ferramenta</label>
                    <input type="text" id="ferramenta-nome" name="nome" required placeholder="Ex: Furadeira de Impacto Bosch">
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn-primary">Salvar Ferramenta</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Lógica do modal de RETIRADA
    const retirarModal = document.getElementById('retirar-modal');
    const modalTitle = document.getElementById('modal-title');
    const retirarForm = document.getElementById('retirar-form');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnsRetirar = document.querySelectorAll('.btn-retirar');
    
    btnsRetirar.forEach(btn => {
        btn.addEventListener('click', () => {
            const ferramentaId = btn.dataset.id;
            const ferramentaNome = btn.dataset.nome;
            modalTitle.innerText = `Retirar: ${ferramentaNome}`;
            retirarForm.action = `/ferramentas/retirar/${ferramentaId}`;
            retirarModal.style.display = 'flex';
        });
    });
    if (btnCloseModal) btnCloseModal.addEventListener('click', () => retirarModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === retirarModal) retirarModal.style.display = 'none'; });

    // Lógica do modal de CADASTRO
    const addFerramentaModal = document.getElementById('add-ferramenta-modal');
    const btnShowAddFerramentaModal = document.getElementById('btn-show-add-ferramenta-modal');
    const btnCloseAddFerramentaModal = document.getElementById('btn-close-add-ferramenta-modal');

    if(btnShowAddFerramentaModal) btnShowAddFerramentaModal.addEventListener('click', () => addFerramentaModal.style.display = 'flex');
    if(btnCloseAddFerramentaModal) btnCloseAddFerramentaModal.addEventListener('click', () => addFerramentaModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === addFerramentaModal) addFerramentaModal.style.display = 'none'; });
});
</script>