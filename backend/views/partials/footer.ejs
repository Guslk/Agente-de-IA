        // Mensagens de processo
        'approve_failed': 'Erro ao aprovar requisição.',
        'cancel_failed': 'Erro ao cancelar requisição.',
        'return_failed': 'Erro ao processar devolução.',
        'complete_return_failed': 'Erro ao processar devolução completa.',
        
        // Mensagens de estoque
        'stock_in_use': 'Não é possível excluir este departamento, pois ele possui itens cadastrados.',
        'item_in_use': 'Não é possível excluir este item, pois ele possui movimentações no histórico.',
        'employee_in_use': 'Este funcionário não pode ser excluído pois está ligado a movimentações.',
        'supplier_in_use': 'Este fornecedor não pode ser excluído pois está ligado a entradas de estoque.',
        'email_in_use': 'O email fornecido já está em uso.',
        'not_admin': 'Acesso negado. Você não tem permissão para esta ação.'
    };
    
    const successMessages = {
        // Mensagens gerais
        'created': 'Registro criado com sucesso!',
        'updated': 'Registro atualizado com sucesso!',
        'deleted': 'Registro movido para a lixeira!',
        'restored': 'Registro restaurado com sucesso!',
        
        // Mensagens específicas de requisições
        'request_created': 'Requisição criada com sucesso!',
        'request_approved': 'Requisição aprovada com sucesso!',
        'request_cancelled': 'Requisição cancelada com sucesso!',
        'devolucao_processada': 'Devolução processada com sucesso!',
        'devolucao_completa': 'Devolução completa realizada com sucesso!'
    };

    // 3. Função para obter mensagem com fallback
    function getMessage(code, isError = true) {
        const messages = isError ? errorMessages : successMessages;
        return messages[code] || (isError ? `Erro: ${code}` : 'Operação realizada com sucesso!');
    }

    // 4. Verifica a URL e aciona os pop-ups
    const urlParams = new URLSearchParams(window.location.search);
    const successQuery = urlParams.get('success');
    const errorQuery = urlParams.get('error');

    if (successQuery) {
        const message = getMessage(successQuery, false);
        showToast(message, false);
    }

    if (errorQuery) {
        const message = getMessage(errorQuery, true);
        showToast(message, true);
    }
    
    // 5. Limpa a URL para que o pop-up não apareça novamente se o usuário atualizar a página
    if (successQuery || errorQuery) {
        const cleanUrl = window.location.origin + window.location.pathname + window.location.hash;
        window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
    }

