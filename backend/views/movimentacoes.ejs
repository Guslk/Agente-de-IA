<%- include('partials/header', { title: 'Movimentações', paginaAtiva: 'movimentacoes' }) %>

<header class="header">
    <h1 class="header-title">Histórico de Movimentações</h1>
    <div class="user-profile">
        <span>Bem-vindo, João</span>
        <img src="https://i.pravatar.cc/40?u=joao" alt="Avatar">
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Todas as Entradas e Saídas de Itens</h2>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Data e Hora</th>
                    <th>Item</th>
                    <th>Tipo</th>
                    <th>Quantidade</th>
                    <th>Responsável</th>
                    <th>Detalhe</th>
                </tr>
            </thead>
            <tbody>
                <% if (movimentacoes.length > 0) { %>
                    <% movimentacoes.forEach(mov => { %>
                        <tr>
                            <td><%= new Date(mov.data).toLocaleString('pt-BR') %></td>
                            <td><strong><%= mov.itemNome %></strong></td>
                            <td>
                                <% if (mov.tipo === 'Entrada') { %>
                                    <span class="status-pill status-ok"><%= mov.tipo %></span>
                                <% } else { %>
                                    <span class="status-pill status-empty"><%= mov.tipo %></span>
                                <% } %>
                            </td>
                            <td><%= mov.quantidade %></td>
                            <td><%= mov.responsavel %></td>
                            <td><%= mov.detalhe || 'N/A' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" style="text-align: center;">Nenhuma movimentação registrada.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<%- include('partials/footer') %>