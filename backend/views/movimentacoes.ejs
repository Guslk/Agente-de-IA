<%- include('partials/header', { title: 'Movimentações', paginaAtiva: 'movimentacoes' }) %>

<%
    // --- Lógica EJS para ajudar a construir os links de ordenação ---
    const sortColumn = (typeof currentSort !== 'undefined') ? currentSort.column : 'date';
    const sortOrder = (typeof currentSort !== 'undefined') ? currentSort.order : 'DESC';

    const currentFilters = new URLSearchParams(typeof filters !== 'undefined' ? filters : {});
    currentFilters.delete('sort');
    currentFilters.delete('order');
    const filterParams = currentFilters.toString();

    const createSortUrl = (columnName) => {
        let newOrder = 'ASC';
        if (columnName === sortColumn) {
            newOrder = (sortOrder === 'ASC') ? 'DESC' : 'ASC';
        }
        return `/movimentacoes?sort=${columnName}&order=${newOrder}&${filterParams}`;
    };

    const getSortIcon = (columnName) => {
        if (columnName === sortColumn) {
            return (sortOrder === 'ASC') ? ' <i class="bi bi-sort-down"></i>' : ' <i class="bi bi-sort-up"></i>';
        }
        return '';
    };
%>

<header class="header">
    <h1 class="header-title">Movimentações de Estoque</h1>
    </header>

<main class="main-content">
    <div class="main-header">
        <h2>Histórico de Movimentações</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-show-entry-modal"><i class="bi bi-plus-circle"></i> Registrar Entrada</button>
            <button class="btn-saida" id="btn-show-output-modal"><i class="bi bi-dash-circle"></i> Registrar Saída</button>
        </div>
    </div>

    <section class="filter-section">
        <form action="/movimentacoes" method="GET" class="filter-form" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));">
            <div class="form-group">
                <label for="filter-item">Item</label>
                <select name="itemId" id="filter-item">
                    <option value="">Todos os Itens</option>
                    <% if (typeof items !== 'undefined') { %>
                        <% items.forEach(item => { %>
                            <option value="<%= item.id %>" <%= (filters.itemId == item.id) ? 'selected' : '' %>>
                                <%= item.name %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="form-group">
                <label for="filter-supplier">Fornecedor (Entradas)</label>
                <select name="supplierId" id="filter-supplier">
                    <option value="">Todos</option>
                    <% if (typeof suppliers !== 'undefined') { %>
                        <% suppliers.forEach(sup => { %>
                            <option value="<%= sup.id %>" <%= (filters.supplierId == sup.id) ? 'selected' : '' %>>
                                <%= sup.name %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="form-group">
                <label for="filter-type">Tipo de Movimento</label>
                <select name="movementType" id="filter-type">
                    <option value="todos">Todos</option>
                    <option value="Entrada" <%= (filters.movementType == 'Entrada') ? 'selected' : '' %>>Apenas Entradas</option>
                    <option value="Saída" <%= (filters.movementType == 'Saída') ? 'selected' : '' %>>Apenas Saídas</option>
                </select>
            </div>
            <div class="form-group">
                <label for="filter-details">OS / Justificativa (Saídas)</label>
                <input type="text" name="details" id="filter-details" value="<%= filters.details || '' %>" placeholder="Buscar em OS ou Justificativa...">
            </div>
            <div class="form-group">
                <label for="filter-startDate">Data Início</label>
                <input type="date" name="startDate" id="filter-startDate" value="<%= filters.startDate || '' %>">
            </div>
            <div class="form-group">
                <label for="filter-endDate">Data Fim</label>
                <input type="date" name="endDate" id="filter-endDate" value="<%= filters.endDate || '' %>">
            </div>
            <button type="submit" class="btn-primary" style="align-self: end;"><i class="bi bi-search"></i> Filtrar</button>
        </form>
    </section>

    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th><a href="<%= createSortUrl('date') %>">Data <%- getSortIcon('date') %></a></th>
                    <th><a href="<%= createSortUrl('item') %>">Item <%- getSortIcon('item') %></a></th>
                    <th><a href="<%= createSortUrl('quantity') %>">Quantidade <%- getSortIcon('quantity') %></a></th>
                    <th><a href="<%= createSortUrl('unitPrice') %>">Valor Unitário <%- getSortIcon('unitPrice') %></a></th>
                    <th>Detalhes</th>
                    <th><a href="<%= createSortUrl('type') %>">Tipo <%- getSortIcon('type') %></a></th>
                </tr>
            </thead>
            <tbody>
                <% if (movements.length > 0) { %>
                    <% movements.forEach(mov => { %>
                        <tr class="<%= mov.type === 'Entrada' ? 'stock-in' : 'stock-out' %>">
                            <td><%= new Date(mov.date).toLocaleString('pt-BR') %></td>
                            <td><strong><%= mov.item %></strong></td>
                            <td><%= mov.quantity %></td>
                            <td><%= mov.unitPrice %></td>
                            <td><%= mov.details %></td>
                            <td><%= mov.type %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="5" style="text-align: center;">Nenhuma movimentação encontrada para os filtros selecionados.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>
