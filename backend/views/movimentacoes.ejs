<%- include('partials/footer') %>


<script>
document.addEventListener('DOMContentLoaded', () => {
    // ======================================================
    // PARTE 1: REFERÊNCIAS AOS ELEMENTOS DO HTML
    // ======================================================
    const entryModal = document.getElementById('entrada-modal');
    const btnShowEntryModal = document.getElementById('btn-show-entrada-modal');
    const btnCloseEntryModal = document.getElementById('btn-close-entrada-modal');

    const entryItemSelect = document.getElementById('entry-itemId');
    const entryBatchSelect = document.getElementById('entry-batchId');
    const entryBatchGroup = document.getElementById('batch-selection-group');
    const entryNewBatchGroup = document.getElementById('new-batch-group');
    const entryNewBatchInput = document.getElementById('entry-newBatchCode');

    // ======================================================
    // PARTE 2: LÓGICA PARA ABRIR E FECHAR O MODAL DE ENTRADA
    // ======================================================

    if (btnShowEntryModal) {
        btnShowEntryModal.addEventListener('click', () => {
            entryModal.style.display = 'flex';
        });
    }
    if (btnCloseEntryModal) {
        btnCloseEntryModal.addEventListener('click', () => {
            entryModal.style.display = 'none';
        });
    }
    window.addEventListener('click', (e) => {
        if (e.target === entryModal) {
            entryModal.style.display = 'none';
        }
    });

    // ======================================================
    // PARTE 3: FUNÇÃO REUTILIZÁVEL PARA BUSCAR E POPULAR LOTES
    // ======================================================

    const fetchAndPopulateBatches = async (itemId, batchSelectElem) => {
        const batchGroup = batchSelectElem.parentElement;
        if (!itemId) {
            batchGroup.style.display = 'none';
            return;
        }

        try {
            const response = await fetch(`/api/items/${itemId}/batches`);
            if (!response.ok) {
                throw new Error(`API response was not ok: ${response.statusText}`);
            }
            
            const batches = await response.json();

            // Limpa apenas as opções de lotes existentes (da posição 1 em diante)
            while (batchSelectElem.options.length > 1) {
                batchSelectElem.remove(1);
            }

            if (batches.length > 0) {
                batches.forEach(batch => {
                    // SÓ ADICIONA O LOTE AO DROPDOWN SE AINDA TIVER ESTOQUE DISPONÍVEL
                    if (batch.currentQuantity > 0) {
                        const option = document.createElement('option');
                        option.value = batch.id;
                        // ===============================================
                        //       MELHORIA APLICADA AQUI 👇
                        // ===============================================
                        // Agora exibe a quantidade ATUAL disponível
                        option.textContent = `${batch.batchCode} (Qty Available: ${batch.currentQuantity})`;
                        batchSelectElem.appendChild(option);
                    }
                });
            }
            
            batchGroup.style.display = 'block';
            
        } catch (error) {
            console.error('Failed to fetch batches:', error);
            batchGroup.style.display = 'none';
        }
    };
    
    // ======================================================
    // PARTE 4: LÓGICA DINÂMICA PARA O MODAL DE ENTRADA
    // ======================================================
    
    if (entryItemSelect) {
        entryItemSelect.addEventListener('change', async (e) => {
            const itemId = e.target.value;
            
            // Esconde e reseta os campos de lote
            entryNewBatchGroup.style.display = 'none';
            entryNewBatchInput.required = false;
            entryNewBatchInput.value = '';

            await fetchAndPopulateBatches(itemId, entryBatchSelect);

            // Garante que a opção "Create New" esteja selecionada por padrão
            entryBatchSelect.value = 'new';
            
            // Dispara o evento 'change' para mostrar o campo de novo lote
            entryBatchSelect.dispatchEvent(new Event('change'));
        });

        entryBatchSelect.addEventListener('change', (e) => {
            if (e.target.value === 'new') {
                entryNewBatchGroup.style.display = 'block';
                entryNewBatchInput.required = true;
            } else {
                entryNewBatchGroup.style.display = 'none';
                entryNewBatchInput.required = false;
                entryNewBatchInput.value = '';
            }
        });
    }
});
</script> -->


<%- include('partials/header', { title: 'Movimentações', paginaAtiva: 'movimentacoes' }) %>

<header class="header">
    <h1 class="header-title">Registro de Movimentações</h1>
    <div class="header-right">
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.name %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar">
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Stock Operations</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-show-entry-modal">Register Entry</button>
            <button class="btn-saida" id="btn-show-output-modal">Register Output</button>
        </div>
    </div>

    <h1>Movement History</h1>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Item</th>
                    <th>Quantidade</th>
                    <th>Detalhes</th>
                    <th>Type</th>
                </tr>
            </thead>
            <tbody>
                <% if (movements.length > 0) { %>
                    <% movements.forEach(mov => { %>
                        <tr class="<%= mov.type === 'Entry' ? 'stock-in' : 'stock-out' %>">
                            <td><%= new Date(mov.date).toLocaleString('pt-BR') %></td>
                            <td><%= mov.item %></td>
                            <td><%= mov.quantity %></td>
                            <td><%= mov.details %></td>
                            <td><%= mov.type %></td>                            
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="5" style="text-align: center;">No movements found.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<div class="modal-overlay" id="entry-modal">
    <div class="modal">
        <div class="modal-header"><h3>Register Entry</h3><button class="close-button" id="btn-close-entry-modal">&times;</button></div>
        <form action="/entries" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label for="entry-itemId">Item</label>
                    <select name="itemId" required>
                        <option value="" disabled selected>Select an item...</option>
                        <% items.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }); %>
                    </select>
                </div>
                <div class="form-group"><label for="entry-quantity">Quantity</label><input type="number" name="quantity" min="1" required></div>
                <div class="form-group">
                    <label for="entry-supplierId">Supplier</label>
                    <select name="supplierId" required>
                        <option value="" disabled selected>Select...</option>
                        <% suppliers.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
                    </select>
                </div>
                <div class="form-group"><label for="entry-invoiceNumber">Invoice Number</label><input type="text" name="invoiceNumber"></div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Confirm Entry</button></div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="output-modal">
    <div class="modal">
        <div class="modal-header"><h3>Register Output</h3><button class="close-button" id="btn-close-output-modal">&times;</button></div>
        <form action="/outputs" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label for="output-itemId">Item</label>
                    <select name="itemId" required>
                        <option value="" disabled selected>Select an item...</option>
                        <% items.forEach(item => { %><option value="<%= item.id %>"><%= item.name %> (Available: <%= item.quantity %>)</option><% }); %>
                    </select>
                </div>
                <div class="form-group"><label for="output-quantity">Quantity</label><input type="number" name="quantity" min="1" required></div>
                <div class="form-group"><label for="output-justification">Justification</label><input type="text" name="justification"></div>
                <div class="form-group"><label for="output-productionOrder">Production Order (OS)</label><input type="text" name="productionOrder"></div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-danger">Confirm Output</button></div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const entryModal = document.getElementById('entry-modal');
        const outputModal = document.getElementById('output-modal');
        
        document.getElementById('btn-show-entry-modal').addEventListener('click', () => entryModal.style.display = 'flex');
        document.getElementById('btn-close-entry-modal').addEventListener('click', () => entryModal.style.display = 'none');
        
        document.getElementById('btn-show-output-modal').addEventListener('click', () => outputModal.style.display = 'flex');
        document.getElementById('btn-close-output-modal').addEventListener('click', () => outputModal.style.display = 'none');
        
        window.addEventListener('click', (e) => {
            if (e.target === entryModal) entryModal.style.display = 'none';
            if (e.target === outputModal) outputModal.style.display = 'none';
        });
    });
</script>