<%- include('partials/header', { title: 'Movimentações', paginaAtiva: 'movimentacoes' }) %>

<%
    // --- Lógica EJS para ajudar a construir os links de ordenação ---
    const sortColumn = (typeof currentSort !== 'undefined') ? currentSort.column : 'date';
    const sortOrder = (typeof currentSort !== 'undefined') ? currentSort.order : 'DESC';

    const currentFilters = new URLSearchParams(typeof filters !== 'undefined' ? filters : {});
    currentFilters.delete('sort');
    currentFilters.delete('order');
    const filterParams = currentFilters.toString();

    const createSortUrl = (columnName) => {
        let newOrder = 'ASC';
        if (columnName === sortColumn) {
            newOrder = (sortOrder === 'ASC') ? 'DESC' : 'ASC';
        }
        return `/movimentacoes?sort=${columnName}&order=${newOrder}&${filterParams}`;
    };

    const getSortIcon = (columnName) => {
        if (columnName === sortColumn) {
            return (sortOrder === 'ASC') ? ' <i class="bi bi-sort-down"></i>' : ' <i class="bi bi-sort-up"></i>';
        }
        return '';
    };
%>

<header class="header">
    <h1 class="header-title">Movimentações de Estoque</h1>
    <!-- Adicionado header-right para consistência -->
    <div class="header-right">
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.nome || user.name %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar" class="avatar-img">
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Histórico de Movimentações</h2>
        <div class="action-buttons">
             <!-- Botões com classes primárias e cores específicas via style -->
            <button class="btn-primary" id="btn-show-entry-modal" style="background-color: var(--success);"><i class="bi bi-plus-circle"></i> Registrar Entrada</button>
            <button class="btn-primary" id="btn-show-output-modal" style="background-color: var(--danger);"><i class="bi bi-dash-circle"></i> Registrar Saída</button>
        </div>
    </div>

    <!-- Filtros com classes corretas -->
    <section class="filter-section">
        <form action="/movimentacoes" method="GET" class="filter-form">
            <div class="form-group">
                <label for="filter-item">Item</label>
                <select name="itemId" id="filter-item">
                    <option value="">Todos os Itens</option>
                    <% if (typeof items !== 'undefined') { %>
                        <% items.forEach(item => { %>
                            <option value="<%= item.id %>" <%= (filters.itemId == item.id) ? 'selected' : '' %>>
                                <%= item.name %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="form-group">
                <label for="filter-supplier">Fornecedor (Entradas)</label>
                <select name="supplierId" id="filter-supplier">
                    <option value="">Todos</option>
                    <% if (typeof suppliers !== 'undefined') { %>
                        <% suppliers.forEach(sup => { %>
                            <option value="<%= sup.id %>" <%= (filters.supplierId == sup.id) ? 'selected' : '' %>>
                                <%= sup.name %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="form-group">
                <label for="filter-type">Tipo de Movimento</label>
                <select name="movementType" id="filter-type">
                    <option value="todos">Todos</option>
                    <option value="Entrada" <%= (filters.movementType == 'Entrada') ? 'selected' : '' %>>Apenas Entradas</option>
                    <option value="Saída" <%= (filters.movementType == 'Saída') ? 'selected' : '' %>>Apenas Saídas</option>
                </select>
            </div>
            <div class="form-group">
                <label for="filter-details">OS / Justificativa (Saídas)</label>
                <input type="text" name="details" id="filter-details" value="<%= filters.details || '' %>" placeholder="Buscar...">
            </div>
            <div class="form-group">
                <label for="filter-startDate">Data Início</label>
                <input type="date" name="startDate" id="filter-startDate" value="<%= filters.startDate || '' %>">
            </div>
            <div class="form-group">
                <label for="filter-endDate">Data Fim</label>
                <input type="date" name="endDate" id="filter-endDate" value="<%= filters.endDate || '' %>">
            </div>
            <button type="submit" class="btn-primary" style="align-self: end;"><i class="bi bi-search"></i> Filtrar</button>
        </form>
    </section>

    <!-- Tabela com classe correta -->
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <!-- Links de ordenação -->
                    <th><a href="<%= createSortUrl('date') %>">Data<%- getSortIcon('date') %></a></th>
                    <th><a href="<%= createSortUrl('item') %>">Item<%- getSortIcon('item') %></a></th>
                    <th><a href="<%= createSortUrl('quantity') %>">Quantidade<%- getSortIcon('quantity') %></a></th>
                    <th><a href="<%= createSortUrl('unitPrice') %>">Valor Unitário<%- getSortIcon('unitPrice') %></a></th>
                    <th>Detalhes</th> <!-- Sem ordenação -->
                    <th><a href="<%= createSortUrl('type') %>">Tipo<%- getSortIcon('type') %></a></th>
                </tr>
            </thead>
            <tbody>
                <% if (movements.length > 0) { %>
                    <% movements.forEach(mov => { %>
                        <!-- Classes stock-in/stock-out já corretas -->
                        <tr class="<%= mov.type === 'Entrada' ? 'stock-in' : 'stock-out' %>">
                            <td><%= new Date(mov.date).toLocaleString('pt-BR') %></td>
                            <td><strong><%= mov.item %></strong></td>
                            <td><%= mov.quantity %></td>
                             <!-- Formatando valor monetário -->
                            <td><%= typeof mov.unitPrice === 'number' ? `R$ ${mov.unitPrice.toFixed(2)}` : 'N/A' %></td>
                            <td><%= mov.details %></td>
                            <td><%= mov.type %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="6" style="text-align: center;">Nenhuma movimentação encontrada para os filtros selecionados.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<!-- Modal de Entrada - Estrutura atualizada -->
<div class="modal-overlay" id="entry-modal">
    <div class="modal"> <!-- Tamanho padrão -->
        <div class="modal-header">
            <h3>Registrar Entrada</h3>
            <button class="close-button" id="btn-close-entry-modal">&times;</button>
        </div>
        <form action="/entries" method="POST">
            <div class="modal-body">
                <!-- Usando form-grid para layout -->
                <div class="form-grid">
                    <div class="form-group full-width"> <!-- full-width para ocupar as duas colunas -->
                        <label for="entry-itemId">Item</label>
                        <select name="itemId" id="entry-itemId" required>
                            <option value="" disabled selected>Selecione um item...</option>
                            <% if(typeof items !== 'undefined') { items.forEach(item => { %>
                                <option value="<%= item.id %>"><%= item.name %></option>
                            <% }); } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="entry-quantity">Quantidade</label>
                        <!-- Corrigido para type="number" -->
                        <input type="number" id="entry-quantity" name="quantity" min="0.01" step="0.01" required>
                    </div>
                    <div class="form-group">
                        <label for="entry-unitPrice">Preço Unitário (R$)</label>
                        <input type="number" id="entry-unitPrice" name="unitPrice" step="0.01" min="0" required>
                    </div>
                    <div class="form-group">
                        <label for="entry-supplierId">Fornecedor</label>
                        <select name="supplierId" id="entry-supplierId" required>
                            <option value="" disabled selected>Selecione...</option>
                            <% if(typeof suppliers !== 'undefined') { suppliers.forEach(s => { %>
                                <option value="<%= s.id %>"><%= s.name %></option>
                            <% }); } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="entry-invoiceNumber">Número da Nota Fiscal</label>
                        <input type="text" id="entry-invoiceNumber" name="invoiceNumber">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn-primary">Confirmar Entrada</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Saída - Estrutura atualizada -->
<div class="modal-overlay" id="output-modal">
    <div class="modal"> <!-- Tamanho padrão -->
        <div class="modal-header">
            <h3>Registrar Saída</h3>
            <button class="close-button" id="btn-close-output-modal">&times;</button>
        </div>
        <form action="/outputs" method="POST">
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label for="output-itemId">Item</label>
                        <select name="itemId" id="output-itemId" required>
                            <option value="" disabled selected>Selecione um item...</option>
                            <% if(typeof items !== 'undefined') { items.forEach(item => { %>
                                <!-- Mostra quantidade disponível -->
                                <option value="<%= item.id %>"><%= item.name %> (Disponível: <%= item.quantity || 0 %>)</option>
                            <% }); } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="output-quantity">Quantidade</label>
                        <input type="number" id="output-quantity" name="quantity" min="1" required>
                    </div>
                     <div class="form-group">
                        <label for="output-productionOrder">Ordem de Produção (OS)</label>
                        <input type="text" id="output-productionOrder" name="productionOrder">
                    </div>
                    <div class="form-group full-width">
                        <label for="output-justification">Justificativa / Observação</label>
                        <input type="text" id="output-justification" name="justification">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- Usando btn-primary com cor danger -->
                <button type="submit" class="btn-primary" style="background-color: var(--danger);">Confirmar Saída</button>
            </div>
        </form>
    </div>
</div>

<!-- Script JS existente (IDs foram mantidos) -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const entryModal = document.getElementById('entry-modal');
        const outputModal = document.getElementById('output-modal');
        const btnShowEntry = document.getElementById('btn-show-entry-modal');
        const btnCloseEntry = document.getElementById('btn-close-entry-modal');
        const btnShowOutput = document.getElementById('btn-show-output-modal');
        const btnCloseOutput = document.getElementById('btn-close-output-modal');

        if(entryModal && btnShowEntry && btnCloseEntry) {
            btnShowEntry.addEventListener('click', () => entryModal.style.display = 'flex');
            btnCloseEntry.addEventListener('click', () => entryModal.style.display = 'none');
            window.addEventListener('click', (e) => {
                if (e.target === entryModal) entryModal.style.display = 'none';
            });
        }
        
        if(outputModal && btnShowOutput && btnCloseOutput) {
            btnShowOutput.addEventListener('click', () => outputModal.style.display = 'flex');
            btnCloseOutput.addEventListener('click', () => outputModal.style.display = 'none');
            window.addEventListener('click', (e) => {
                if (e.target === outputModal) outputModal.style.display = 'none';
            });
        }
    });
</script>

<%- include('partials/footer') %>

<style>
    .inventory-table th a {
        color: inherit; /* Usa a cor padrão do texto do cabeçalho */
        text-decoration: none; /* Remove o sublinhado */
        display: block; /* Garante que o link ocupe toda a célula */
        width: 100%;
        transition: color 0.2s ease; /* Adiciona uma transição suave */
    }
    .inventory-table th a:hover {
        color: var(--primary-color); /* Muda a cor ao passar o mouse (opcional) */
         /* text-decoration: underline; */ /* Adiciona sublinhado ao passar o mouse (opcional) */
    }
     .inventory-table th a i {
         /* Ajusta ligeiramente a aparência do ícone de ordenação */
        font-size: 0.9em;
        opacity: 0.7;
     }
</style>