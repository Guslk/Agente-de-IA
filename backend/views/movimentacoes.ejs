<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StockEx - Movimentações</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <div class="container">
        <aside class="sidebar">
            <div class="logo"><i class="bi bi-archive-fill"></i> StockEx</div>
            <nav class="nav-menu">
                <ul>
    <li><a href="/"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a></li>
    <li><a href="/itens"><i class="bi bi-box-seam"></i> Itens</a></li>
    <li><a href="/movimentacoes"><i class="bi bi-arrow-down-up"></i> Movimentações</a></li>
    <li><a href="/fornecedores"><i class="bi bi-truck"></i> Fornecedores</a></li>
    <li><a href="/funcionarios" class="active"><i class="bi bi-people-fill"></i> Funcionários</a></li>
    <li><a href="/relatorios"><i class="bi bi-bar-chart-fill"></i> Relatórios</a></li>
</ul>
            </nav>
        </aside>

        <header class="header">
            <h1 class="header-title">Histórico de Movimentações</h1>
            <div class="user-profile">
                <span>Bem-vindo, João</span>
                <img src="https://i.pravatar.cc/40?u=joao" alt="Avatar">
            </div>
        </header>

        <main class="main-content">
            <div class="main-header">
                <h2>Entradas e Saídas</h2>
                </div>
            <section class="inventory-table">
                <table>
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Data</th>
                            <th>Item</th>
                            <th>Quantidade</th>
                            <th>Funcionário</th>
                            <th>Detalhes</th>
                        </tr>
                    </thead>
                    <tbody id="movimentacoes-table-body">
                        </tbody>
                </table>
            </section>
        </main>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const movimentacoes = [
        { tipo: 'Entrada', data: '02/09/2025', item: 'SSD NVMe 256GB', qtd: 50, funcionario: 'João da Silva', detalhe: 'NF-e 123456' },
        { tipo: 'Saída', data: '01/09/2025', item: 'Mouse Gamer Logitech G203', qtd: 5, funcionario: 'Maria Oliveira', detalhe: 'Setor de TI' },
        { tipo: 'Entrada', data: '31/08/2025', item: 'Memória RAM DDR4 8GB', qtd: 20, funcionario: 'João da Silva', detalhe: 'NF-e 123123' },
        { tipo: 'Saída', data: '30/08/2025', item: 'Teclado Dell KB216', qtd: 10, funcionario: 'Maria Oliveira', detalhe: 'Setor Administrativo' }
    ];

    const tableBody = document.getElementById('movimentacoes-table-body');
    tableBody.innerHTML = '';
    movimentacoes.forEach(m => {
        const tipoClass = m.tipo === 'Entrada' ? 'color: var(--success);' : 'color: var(--danger);';
        const tipoIcon = m.tipo === 'Entrada' ? 'bi-arrow-down-circle-fill' : 'bi-arrow-up-circle-fill';

        const row = `
            <tr>
                <td><strong style="${tipoClass}"><i class="bi ${tipoIcon}"></i> ${m.tipo}</strong></td>
                <td>${m.data}</td>
                <td><strong>${m.item}</strong></td>
                <td>${m.qtd}</td>
                <td>${m.funcionario}</td>
                <td>${m.detalhe}</td>
            </tr>
        `;
        tableBody.innerHTML += row;
    });
});
</script>
</body>
</html>