
<%- include('partials/header', { title: 'Movimentações', paginaAtiva: 'movimentacoes' }) %>

<%
    // --- Lógica EJS para ajudar a construir os links de ordenação ---
    const sortInfo = typeof currentSort !== 'undefined' ? currentSort : { column: 'date', order: 'DESC' };
    const pageInfo = typeof pagination !== 'undefined' ? pagination : { currentPage: 1, totalPages: 1, totalItems: 0 }; // Adicionado para futura paginação
    const filterInfo = typeof filters !== 'undefined' ? filters : {};

    // Construir URL com filtros
    const currentFilters = new URLSearchParams(filterInfo);
    currentFilters.delete('sort');
    currentFilters.delete('order');
    currentFilters.delete('page');
    const filterParams = currentFilters.toString();

    const createSortUrl = (columnName) => {
        let newOrder = 'ASC';
        if (columnName === sortInfo.column) {
            newOrder = (sortInfo.order === 'ASC') ? 'DESC' : 'ASC';
        }
        return `/movimentacoes?sort=${columnName}&order=${newOrder}&${filterParams ? filterParams + '&' : ''}page=${pageInfo.currentPage}`;
    };

    const getSortIcon = (columnName) => {
        if (columnName === sortInfo.column) {
            return (sortInfo.order === 'ASC') ? ' <i class="bi bi-sort-down"></i>' : ' <i class="bi bi-sort-up"></i>';
        }
        return '';
    };

    // const createPageUrl = (page) => {
    //     return `/movimentacoes?${filterParams ? filterParams + '&' : ''}sort=${sortInfo.column}&order=${sortInfo.order}&page=${page}`;
    // };
%>

<header class="header">
    <h1 class="header-title">Movimentações de Estoque</h1>
    <div class="header-right">
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.nome || user.name %></span>
<div class="user-avatar">
    <% if (typeof user !== 'undefined' && user.photo) { %>
        <img src="<%= user.photo %>" alt="Avatar de <%= user.name %>" 
             onerror="this.src='img/usuario.jpg'">
    <% } else { %>
        <img src="img/usuario.jpg" alt="Avatar">
    <% } %>
</div>
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">

    <div class="main-header">
        <div class="header-content">
            <h2>Histórico de Movimentações</h2>
            <p class="header-subtitle">Visualize todas as entradas e saídas do seu inventário</p>
        </div>
        <div class="action-buttons">
            <button class="btn btn-success" id="btn-show-entry-modal">
                <i class="bi bi-plus-circle"></i> Registrar Entrada
            </button>
            <button class="btn btn-danger" id="btn-show-output-modal">
                <i class="bi bi-dash-circle"></i> Registrar Saída
            </button>
        </div>
    </div>

    <section class="filter-section">
        <div class="filter-header">
            <h3><i class="bi bi-funnel"></i> Filtros</h3>
            <button type="button" class="btn btn-link" id="btn-clear-filters">
                <i class="bi bi-arrow-clockwise"></i> Limpar Filtros
            </button>
        </div>
        <form action="/movimentacoes" method="GET" class="filter-form" id="filter-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="filter-item" class="form-label"><i class="bi bi-box-seam"></i> Item</label>
                    <select name="itemId" id="filter-item" class="form-select">
                        <option value="">Todos os Itens</option>
                        <% if (typeof items !== 'undefined') { %>
                            <% items.forEach(item => { %>
                                <option value="<%= item.id %>" <%= (filterInfo.itemId == item.id) ? 'selected' : '' %>>
                                    <%= item.name %>
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="filter-supplier" class="form-label"><i class="bi bi-truck"></i> Fornecedor (Entradas)</label>
                    <select name="supplierId" id="filter-supplier" class="form-select">
                        <option value="">Todos</option>
                        <% if (typeof suppliers !== 'undefined') { %>
                            <% suppliers.forEach(sup => { %>
                                <option value="<%= sup.id %>" <%= (filterInfo.supplierId == sup.id) ? 'selected' : '' %>>
                                    <%= sup.name %>
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="filter-type" class="form-label"><i class="bi bi-arrows-expand"></i> Tipo de Movimento</label>
                    <select name="movementType" id="filter-type" class="form-select">
                        <option value="todos" <%= (!filterInfo.movementType || filterInfo.movementType === 'todos') ? 'selected' : '' %>>Todos os Tipos</option>
                        <option value="Entrada" <%= (filterInfo.movementType == 'Entrada') ? 'selected' : '' %>>Apenas Entradas</option>
                        <option value="Saída" <%= (filterInfo.movementType == 'Saída') ? 'selected' : '' %>>Apenas Saídas</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="filter-details" class="form-label"><i class="bi bi-search"></i> OS / NF / Detalhes</label>
                    <input type="text" name="details" id="filter-details" class="form-input" value="<%= filterInfo.details || '' %>" placeholder="Buscar em OS, NF, Justificativa...">
                </div>
                <div class="form-group">
                    <label for="filter-startDate" class="form-label"><i class="bi bi-calendar-date"></i> Data Início</label>
                    <input type="date" name="startDate" id="filter-startDate" class="form-input" value="<%= filterInfo.startDate || '' %>">
                </div>
                <div class="form-group">
                    <label for="filter-endDate" class="form-label"><i class="bi bi-calendar-date"></i> Data Fim</label>
                    <input type="date" name="endDate" id="filter-endDate" class="form-input" value="<%= filterInfo.endDate || '' %>">
                </div>
            </div>
             <div class="form-row">
                <div class="form-group" style="margin-left: auto;"> <button type="submit" class="btn btn-primary btn-filter">
                        <i class="bi bi-search"></i> Aplicar Filtros
                    </button>
                </div>
            </div>
        </form>
    </section>

    <section class="table-section">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th width="180"><a href="<%= createSortUrl('date') %>" class="sort-link">Data<%- getSortIcon('date') %></a></th>
                        <th><a href="<%= createSortUrl('item') %>" class="sort-link">Item<%- getSortIcon('item') %></a></th>
                        <th width="120" class="text-center"><a href="<%= createSortUrl('quantity') %>" class="sort-link">Quantidade<%- getSortIcon('quantity') %></a></th>
                        <th width="150" class="text-center"><a href="<%= createSortUrl('unitPrice') %>" class="sort-link">Valor Unitário<%- getSortIcon('unitPrice') %></a></th>
                        <th>Detalhes (OS, NF, Fornecedor...)</th>
                        <th width="150" class="text-center"><a href="<%= createSortUrl('type') %>" class="sort-link">Tipo<%- getSortIcon('type') %></a></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (movements.length > 0) { %>
                        <% movements.forEach(mov => { %>
                            <% const isEntry = mov.type === 'Entrada'; %>
                            <tr class_="<%= isEntry ? 'row-success' : 'row-danger' %>">
                                <td><%= new Date(mov.date).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                                <td>
                                    <div class="name-cell">
                                        <strong class="item-name"><%= mov.item %></strong>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="quantity-badge <%= isEntry ? 'badge-success' : 'badge-danger' %>">
                                        <%= isEntry ? '+' : '-' %><%= mov.quantity %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <% if (mov.unitPrice > 0) { %>
                                        <span class="value-total" style="min-width: 100px; padding: 0.5rem 0.75rem;">
                                            R$ <%= mov.unitPrice.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-muted">R$<%= mov.unitPrice.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                                    <% } %>
                                </td>
                                <td class="description-cell" title="<%= mov.details || '' %>">
                                    <%= mov.details || '—' %>
                                </td>
                                <td class="text-center">
                                    <span class="status-badge <%= isEntry ? 'status-success' : 'status-danger' %>">
                                        <i class="bi <%= isEntry ? 'bi-arrow-up-circle' : 'bi-arrow-down-circle' %>"></i>
                                        <%= mov.type %>
                                    </span>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <h4>Nenhuma movimentação encontrada</h4>
                                    <p>Tente ajustar os filtros ou registrar uma nova movimentação.</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    </main>

<div class="modal-overlay" id="entry-modal">
    <div class="modal">
        <div class="modal-header">
            <h3><i class="bi bi-plus-circle"></i> Registrar Entrada</h3>
            <button class="close-button" id="btn-close-entry-modal">&times;</button>
        </div>
        <form action="/entries" method="POST" class="modal-form">
            <div class="modal-body">
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="bi bi-info-circle"></i> Detalhes da Entrada
                    </h4>
                    <div class="form-grid">
                        <div class="form-group full-width">
    <label for="entry-selected-item-name" class="form-label required">Item</label>
    <div class="input-with-button">
        <input type="text" id="entry-selected-item-name" placeholder="Nenhum item selecionado" readonly class="form-control-readonly">
        <button type="button" class="btn-secondary btn-lookup" id="entry-btn-open-search-modal">
            <i class="bi bi-search"></i> Buscar
        </button>
    </div>
    <input type="hidden" name="itemId" id="entry-selected-item-id" required>
    <input type="hidden" id="entry-selected-item-unit">
</div>
                        <div class="form-group">
                            <label for="entry-quantity" class="form-label required">Quantidade</label>
                            <input type="number" id="entry-quantity" name="quantity" class="form-input" min="0.01" step="any" required>
                            <div class="form-hint">Use "." para casas decimais (ex: 1.5)</div>
                        </div>
                        <div class="form-group">
                            <label for="entry-unitPrice" class="form-label required">Preço Unitário (R$)</label>
                            <input type="number" id="entry-unitPrice" name="unitPrice" class="form-input" step="0.01" min="0" required>
                            <div class="form-hint">Valor de compra do item</div>
                        </div>
                        <div class="form-group">
                            <label for="entry-supplierId" class="form-label required">Fornecedor</label>
                            <select name="supplierId" id="entry-supplierId" class="form-select" required>
                                <option value="" disabled selected>Selecione...</option>
                                <% if(typeof suppliers !== 'undefined') { suppliers.forEach(s => { %>
                                    <option value="<%= s.id %>"><%= s.name %></option>
                                <% }); } %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="entry-invoiceNumber" class="form-label">Número da Nota Fiscal</label>
                            <input type="text" id="entry-invoiceNumber" name="invoiceNumber" class="form-input" placeholder="Opcional">
