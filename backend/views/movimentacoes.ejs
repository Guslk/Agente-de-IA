                    <h4 class="form-section-title">
                        <i class="bi bi-info-circle"></i> Detalhes da Saída
                    </h4>
                    <div class="form-grid">
                        <div class="form-group full-width">
    <label for="output-selected-item-name" class="form-label required">Item</label>
    <div class="input-with-button">
        <input type="text" id="output-selected-item-name" placeholder="Nenhum item selecionado" readonly class="form-control-readonly">
        <button type="button" class="btn-secondary btn-lookup" id="output-btn-open-search-modal">
            <i class="bi bi-search"></i> Buscar
        </button>
    </div>
    <input type="hidden" name="itemId" id="output-selected-item-id" required>
    <input type="hidden" id="output-selected-item-unit">
</div>
                        <div class="form-group">
                            <label for="output-quantity" class="form-label required">Quantidade</label>
                            <input type="number" id="output-quantity" name="quantity" class="form-input" min="0.01" step="any" required>
