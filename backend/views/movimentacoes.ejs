<div class="modal-overlay" id="item-search-modal">
    <div class="modal" style="max-width: 600px;">
        <div class="modal-header">
            <h3>Buscar Item Ativo</h3>
            <button class="close-button" id="btn-close-search-modal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label for="item-search-input">Buscar por Nome ou Código</label>
                <input type="text" id="item-search-input" placeholder="Comece a digitar para filtrar a lista..." autocomplete="off">
            </div>
            <div class="search-results-list" id="item-search-results">
                <div class="result-item" style="text-align: center; color: #64748b; padding: 2rem;">
                    Digite para buscar itens...
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>


<script>
    // ===================================================
    // 1. FUNÇÕES AUXILIARES (Formatação e Unidades)
    // ===================================================

    function formatQuantity(quantity, unitOfMeasure) {
        if (!quantity) return '0';
        const qty = parseFloat(quantity);
        const effectiveUnit = unitOfMeasure || 'un';

        if (['kg', 'g', 'ton', 'l', 'ml'].includes(effectiveUnit)) {
            return qty.toFixed(2);
        } else if (['un', 'pc', 'cx'].includes(effectiveUnit)) {
            return qty % 1 === 0 ? qty.toString() : qty.toFixed(2);
        } else {
            return qty.toFixed(2);
        }
    }

    function getUnitLabel(unitOfMeasure) {
        if (!unitOfMeasure) return 'un';
        const unitMap = { 'un': 'un', 'kg': 'kg', 'g': 'g', 'ton': 'ton', 'pc': 'pc', 'cx': 'cx', 'l': 'l', 'ml': 'ml' };
        return unitMap[unitOfMeasure] || unitOfMeasure;
    }

    function getInputStep(unitOfMeasure) {
        if (!unitOfMeasure) return '0.01';
        if (['kg', 'g', 'ton', 'l', 'ml'].includes(unitOfMeasure)) return '0.01';
        if (['un', 'pc'].includes(unitOfMeasure)) return '1';
        if (unitOfMeasure === 'cx') return '0.5';
        return '0.01';
    }

    function getInputMin(unitOfMeasure) {
        if (!unitOfMeasure) return '0.01';
        return ['un', 'pc'].includes(unitOfMeasure) ? '1' : '0.01';
    }

    // ===================================================
    // 2. LÓGICA DE LAYOUT E SIDEBAR (Recuperada)
    // ===================================================
    
    function fixWhiteSpace() {
        const mainContent = document.querySelector('.main-content');
        const body = document.body;
        const html = document.documentElement;
        
        if (!mainContent) return;
        
        const viewportWidth = window.innerWidth;
        
        // Correções imediatas
        body.style.overflowX = 'hidden';
        html.style.overflowX = 'hidden';
        // mainContent.style.overflowX = 'hidden'; // Comentado para permitir scroll interno se necessário
        
        // Aplicar largura total a elementos críticos
        const criticalSelectors = ['.main-content', '.main-header', '.filter-section', '.table-section', '.section-header'];
        
        criticalSelectors.forEach(selector => {
            const elements = document.querySelectorAll(selector);
            elements.forEach(el => {
                if (el) {
                    el.style.width = '100%';
                    el.style.maxWidth = '100%';
                    el.style.boxSizing = 'border-box';
                }
            });
        });
        
        // Correção específica para tabelas
        const tables = document.querySelectorAll('.table-responsive');
        tables.forEach(table => {
            table.style.width = '100%';
            table.style.overflowX = 'auto';
        });
    }

    function setupSidebarControl() {
        const sidebar = document.querySelector('.sidebar');
        
        function updateSidebarLayout() {
            setTimeout(fixWhiteSpace, 150);
        }
        
        if (sidebar) {
            const observer = new MutationObserver(function(mutations) {
                updateSidebarLayout();
            });
            observer.observe(sidebar, { attributes: true, attributeFilter: ['class', 'style'] });
        }
        
        window.addEventListener('resize', () => {
            setTimeout(updateSidebarLayout, 200);
        });
        
        updateSidebarLayout();
    }

    // ===================================================
    // 3. LÓGICA PRINCIPAL DA PÁGINA
    // ===================================================
    document.addEventListener('DOMContentLoaded', function() {
        
        let debounceTimer;
        let searchTarget = null; 

        // --- Captura de Elementos ---
        const entryModal = document.getElementById('entry-modal');
        const outputModal = document.getElementById('output-modal');
        const searchModal = document.getElementById('item-search-modal');

        const btnShowEntry = document.getElementById('btn-show-entry-modal');
        const btnShowOutput = document.getElementById('btn-show-output-modal');

        const btnCloseEntry = document.getElementById('btn-close-entry-modal');
        const btnCloseOutput = document.getElementById('btn-close-output-modal');
        const btnCloseSearch = document.getElementById('btn-close-search-modal');
        const cancelButtons = document.querySelectorAll('.btn-cancel-modal');

        const searchInput = document.getElementById('item-search-input');
        const searchResultsContainer = document.getElementById('item-search-results');

        // Formulário de ENTRADA
        const btnOpenSearchEntry = document.getElementById('entry-btn-open-search-modal');
        const entrySelectedItemName = document.getElementById('entry-selected-item-name');
        const entrySelectedItemId = document.getElementById('entry-selected-item-id');
        const entrySelectedItemUnit = document.getElementById('entry-selected-item-unit');
        const entryQuantityInput = document.getElementById('entry-quantity');

        // Formulário de SAÍDA
        const btnOpenSearchOutput = document.getElementById('output-btn-open-search-modal');
        const outputSelectedItemName = document.getElementById('output-selected-item-name');
        const outputSelectedItemId = document.getElementById('output-selected-item-id');
        const outputSelectedItemUnit = document.getElementById('output-selected-item-unit');
        const outputQuantityInput = document.getElementById('output-quantity');

        // Filtros
        const btnClearFilters = document.getElementById('btn-clear-filters');
        const filterForm = document.getElementById('filter-form');


        // --- Funções de Controle dos Modais ---

        function openModal(modal) {
            if (modal) {
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
                const firstInput = modal.querySelector('input, select, textarea');
                if (firstInput) setTimeout(() => firstInput.focus(), 100);
            }
        }
        
        function closeModal(modal) {
            if (modal) {
                modal.style.display = 'none';
                const anyModalOpen = (entryModal && entryModal.style.display === 'flex') || 
                                     (outputModal && outputModal.style.display === 'flex') || 
                                     (searchModal && searchModal.style.display === 'flex');
                if (!anyModalOpen) {
                    document.body.style.overflow = 'auto';
                }
            }
        }
        
        function closeAllModals() {
            [entryModal, outputModal, searchModal].forEach(modal => closeModal(modal));
        }

        // --- Lógica de Busca de Item ---

        function openSearchModalFunc(target) {
            searchTarget = target;
            openModal(searchModal);
            performSearch(); 
        }

        const performSearch = async () => {
            if (!searchInput || !searchResultsContainer) return;
            const query = searchInput.value;
            try {
                const response = await fetch(`/api/search-items?q=${query}&context=${searchTarget}`);
        const items = await response.json();

                searchResultsContainer.innerHTML = ''; 

                if (items.length > 0) {
                    items.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'result-item';
                        
                        const unitLabel = getUnitLabel(item.unitOfMeasure);
                        const unitClass = item.unitOfMeasure ? `unit-${item.unitOfMeasure}` : 'unit-un';
                        
                        div.innerHTML = `
                            <div>
                                <strong>${item.name}</strong>
                                <span>(Cód: ${item.code || 'N/A'})</span>
                                <span class="unit-badge ${unitClass}">${unitLabel}</span>
                            </div>
                            <span class="qty">Disponível: ${formatQuantity(item.availableQuantity, item.unitOfMeasure)} ${unitLabel}</span>
                        `;
                        
                        if (searchTarget === 'output' && item.availableQuantity <= 0) {
                            div.style.cursor = 'not-allowed';
                            div.style.opacity = '0.5';
                        } else {
                            div.addEventListener('click', () => selectItem(item));
                        }
                        searchResultsContainer.appendChild(div);
                    });
                } else {
                    searchResultsContainer.innerHTML = '<div class="result-item">Nenhum item encontrado.</div>';
                }
            } catch (err) {
                console.error('Erro na busca:', err);
                searchResultsContainer.innerHTML = '<div class="result-item">Erro ao buscar itens.</div>';
            }
        };

        function selectItem(item) {
            const unitLabel = getUnitLabel(item.unitOfMeasure);
            const availableQtyText = formatQuantity(item.availableQuantity, item.unitOfMeasure);
            const displayText = `${item.name} (Disponível: ${availableQtyText} ${unitLabel})`;

            if (searchTarget === 'entry') {
                if(entrySelectedItemName) entrySelectedItemName.value = displayText;
                if(entrySelectedItemId) entrySelectedItemId.value = item.id;
                if(entrySelectedItemUnit) entrySelectedItemUnit.value = item.unitOfMeasure || 'un';
                if(entryQuantityInput) {
                    entryQuantityInput.step = getInputStep(item.unitOfMeasure);
                    entryQuantityInput.min = getInputMin(item.unitOfMeasure);
                    entryQuantityInput.value = '';
                    entryQuantityInput.focus();
                }

            } else if (searchTarget === 'output') {
                if(outputSelectedItemName) outputSelectedItemName.value = displayText;
                if(outputSelectedItemId) outputSelectedItemId.value = item.id;
                if(outputSelectedItemUnit) outputSelectedItemUnit.value = item.unitOfMeasure || 'un';
                if(outputQuantityInput) {
                    outputQuantityInput.step = getInputStep(item.unitOfMeasure);
                    outputQuantityInput.min = getInputMin(item.unitOfMeasure);
                    outputQuantityInput.value = '';
                    outputQuantityInput.focus();
                }
            }

            closeModal(searchModal);
            searchTarget = null; 
            searchInput.value = '';
        }

        // --- Lógica de Notificações ---

        function getSuccessMessage(type) {
            const messages = {
                'mov_created': 'Movimentação registrada com sucesso!',
                'entry_created': 'Entrada registrada com sucesso!',
                'output_created': 'Saída registrada com sucesso!',
            };
            return messages[type] || 'Ação realizada com sucesso!';
        }
        
        function getErrorMessage(type) {
            const messages = {
                'not_found': 'Registro não encontrado!',
                'validation_error': 'Erro de validação. Verifique os dados.',
                'server_error': 'Erro no servidor. Tente novamente.',
                'insufficient_stock': 'Estoque insuficiente para esta saída!'
            };
            return messages[type] || 'Ocorreu um erro!';
        }
        
        function showNotification(message, type) {
            document.querySelectorAll('.notification').forEach(n => n.remove());
            
            const notification = document.createElement('div');
            notification.className = `notification notification-${type}`;
            notification.innerHTML = `
                <div class="notification-content">
                    <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                    <span>${message}</span>
                </div>
                <button class="notification-close"><i class="bi bi-x"></i></button>
            `;
            
            document.body.appendChild(notification);
            
            const closeBtn = notification.querySelector('.notification-close');
            if(closeBtn) {
                closeBtn.addEventListener('click', () => notification.remove());
            }
            setTimeout(() => notification.remove(), 5000);
        }
        
        function cleanUrlParams(paramsToRemove) {
            const url = new URL(window.location.href);
            paramsToRemove.forEach(param => url.searchParams.delete(param));
            window.history.replaceState({}, '', url);
        }

        function setupNotifications() {
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');
            const error = urlParams.get('error');
            
            if (success) {
                showNotification(getSuccessMessage(success), 'success');
                cleanUrlParams(['success', 'error']);
            }
            if (error) {
                showNotification(getErrorMessage(error), 'error');
                cleanUrlParams(['success', 'error']);
            }
        }
        
        // --- Inicialização ---

        function init() {
            console.log('🚀 Inicializando sistema de movimentações...');
            
            // Layout
            fixWhiteSpace();
            setupSidebarControl();

            // Listeners Modais Entrada/Saída
            if (btnShowEntry) btnShowEntry.addEventListener('click', () => openModal(entryModal));
            if (btnCloseEntry) btnCloseEntry.addEventListener('click', () => closeModal(entryModal));
            if (btnShowOutput) btnShowOutput.addEventListener('click', () => openModal(outputModal));
            if (btnCloseOutput) btnCloseOutput.addEventListener('click', () => closeModal(outputModal));

            // Listeners Busca
            if (btnOpenSearchEntry) btnOpenSearchEntry.addEventListener('click', () => openSearchModalFunc('entry'));
            if (btnOpenSearchOutput) btnOpenSearchOutput.addEventListener('click', () => openSearchModalFunc('output'));
            if (btnCloseSearch) btnCloseSearch.addEventListener('click', () => closeModal(searchModal));
            
            if (searchInput) {
                searchInput.addEventListener('input', () => {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(performSearch, 300);
                });
            }

            // Listeners Globais
            cancelButtons.forEach(btn => btn.addEventListener('click', () => closeAllModals()));
            window.addEventListener('click', (e) => {
                if (e.target.classList.contains('modal-overlay')) closeAllModals();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeAllModals();
            });

            // Extras
            if (btnClearFilters) {
                btnClearFilters.addEventListener('click', () => window.location.href = '/movimentacoes');
            }
            
            if (filterForm) {
                filterForm.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
                        e.preventDefault();
                        this.submit();
                    }
                });
            }
            
            setupNotifications();

            console.log('✅ Sistema pronto.');
        }

        // Executar a inicialização
        init();
        
        // Monitorar layout periodicamente para correções
        setInterval(fixWhiteSpace, 2000);
    });
</script>


