<%- include('partials/header', { title: 'Movimentações', paginaAtiva: 'movimentacoes' }) %>

<header class="header">
    <h1 class="header-title">Registro de Movimentações</h1>
    <div class="header-right">
        <div class="notification-icon">
            <i class="bi bi-bell-fill"></i>
            <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
                <span class="notification-badge"><%= lowStockCount %></span>
            <% } %>
        </div>
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.nome %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar">
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Operações de Estoque</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-show-entrada-modal"><i class="bi bi-plus-circle"></i> Registrar Entrada</button>
            <button class="btn-saida" id="btn-show-saida-modal"><i class="bi bi-dash-circle"></i> Registrar Saída</button>
        </div>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Data e Hora</th>
                    <th>Item</th>
                    <th>Tipo</th>
                    <th>Quantidade</th>
                    <th>Responsável</th>
                    <th>Detalhe</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof movimentacoes !== 'undefined' && movimentacoes.length > 0) { %>
                    <% movimentacoes.forEach(mov => { %>
                        <tr>
                            <td><%= new Date(mov.data).toLocaleString('pt-BR') %></td>
                            <td><strong><%= mov.itemNome %></strong></td>
                            <td>
                                <% if (mov.tipo === 'Entrada') { %>
                                    <span class="status-pill status-ok"><%= mov.tipo %></span>
                                <% } else { %>
                                    <span class="status-pill status-empty"><%= mov.tipo %></span>
                                <% } %>
                            </td>
                            <td><%= mov.quantidade %></td>
                            <td><%= mov.responsavel %></td>
                            <td><%= mov.detalhe || 'N/A' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" style="text-align: center;">Nenhuma movimentação registrada.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<div class="modal-overlay" id="entrada-modal">
    <div class="modal" style="max-width: 500px;">
        <div class="modal-header"><h3>Registrar Entrada de Estoque</h3><button class="close-button" id="btn-close-entrada-modal">&times;</button></div>
        <form action="/movimentacoes/entrada" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label for="entrada-itemId">Item</label>
                    <select id="entrada-itemId" name="itemId" required>
                        <option value="" disabled selected>Selecione um item...</option>
                        <% items.forEach(item => { %><option value="<%= item.id_item %>"><%= item.nome %></option><% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="entrada-quantidade">Quantidade a Adicionar</label>
                    <input type="number" id="entrada-quantidade" name="quantidade" min="1" required>
                </div>
                <div class="form-group">
                    <label for="entrada-responsavel">Responsável pela Entrada</label>
                    <select id="entrada-responsavel" name="responsavel" required>
                        <option value="" disabled selected>Selecione um funcionário...</option>
                        <% funcionarios.forEach(func => { %>
                            <option value="<%= func.nome %>"><%= func.nome %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="entrada-nota_fiscal_codigo">Nota Fiscal (Opcional)</label>
                    <input type="text" id="entrada-nota_fiscal_codigo" name="nota_fiscal_codigo">
                </div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Confirmar Entrada</button></div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="saida-modal">
    <div class="modal" style="max-width: 500px;">
        <div class="modal-header"><h3>Registrar Saída de Estoque</h3><button class="close-button" id="btn-close-saida-modal">&times;</button></div>
        <form action="/movimentacoes/saida" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label for="saida-itemId">Item</label>
                    <select id="saida-itemId" name="itemId" required>
                        <option value="" disabled selected>Selecione um item...</option>
                        <% items.forEach(item => { %><option value="<%= item.id_item %>"><%= item.nome %> (Estoque: <%= item.quantidade_atual %>)</option><% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="saida-quantidade">Quantidade a Retirar</label>
                    <input type="number" id="saida-quantidade" name="quantidade" min="1" required>
                </div>
                <div class="form-group">
                    <label for="saida-responsavel">Responsável pela Saída</label>
                    <select id="saida-responsavel" name="responsavel" required>
                        <option value="" disabled selected>Selecione um funcionário...</option>
                        <% funcionarios.forEach(func => { %>
                            <option value="<%= func.nome %>"><%= func.nome %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Confirmar Saída</button></div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const entradaModal = document.getElementById('entrada-modal');
        const saidaModal = document.getElementById('saida-modal');

        document.getElementById('btn-show-entrada-modal').addEventListener('click', () => entradaModal.style.display = 'flex');
        document.getElementById('btn-close-entrada-modal').addEventListener('click', () => entradaModal.style.display = 'none');
        window.addEventListener('click', (e) => { if(e.target === entradaModal) entradaModal.style.display = 'none' });

        document.getElementById('btn-show-saida-modal').addEventListener('click', () => saidaModal.style.display = 'flex');
        document.getElementById('btn-close-saida-modal').addEventListener('click', () => saidaModal.style.display = 'none');
        window.addEventListener('click', (e) => { if(e.target === saidaModal) saidaModal.style.display = 'none' });
    });
</script>