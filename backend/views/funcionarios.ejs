<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StockEx - Funcionários</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar') %>

        <header class="header">
    <h1 class="header-title">Funcionários Cadastrados</h1>
    
    <div class="header-right">
        <div class="notification-icon">
            <i class="bi bi-bell-fill"></i>
            <% if (lowStockCount > 0) { %>
                <span class="notification-badge"><%= lowStockCount %></span>
            <% } %>
        </div>
        <div class="user-profile">
            <span>Bem-vindo, João</span>
            <img src="https://i.pravatar.cc/40?u=joao" alt="Avatar">
        </div>
    </div>
</header>

        <main class="main-content">
            <div class="main-header">
                <h2>Todos os Funcionários Cadastrados</h2>
                <div class="action-buttons">
                    <button class="btn-entrada"><i class="bi bi-plus-circle-fill"></i> Adicionar Novo Funcionário</button>
                </div>
            </div>
            <section class="inventory-table">
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Cargo</th>
                            <th>Email</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="funcionarios-table-body">
                        </tbody>
                </table>
            </section>
        </main>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const funcionarios = [
        { id_funcionario: 1, nome: 'João da Silva', cargo: 'Almoxarife Chefe', email: 'joao.silva@empresa.com' },
        { id_funcionario: 2, nome: 'Maria Oliveira', cargo: 'Assistente de Logística', email: 'maria.oliveira@empresa.com' },
        { id_funcionario: 3, nome: 'Pedro Martins', cargo: 'Estoquista', email: 'pedro.martins@empresa.com' }
    ];

    const tableBody = document.getElementById('funcionarios-table-body');
    tableBody.innerHTML = '';
    funcionarios.forEach(f => {
        const row = `
            <tr>
                <td><strong>${f.nome}</strong></td>
                <td>${f.cargo}</td>
                <td>${f.email}</td>
                <td>
                    <button title="Editar" style="border:none; background:none; cursor:pointer; color: var(--primary-color); font-size: 1.2rem;"><i class="bi bi-pencil-square"></i></button>
                    <button title="Excluir" style="border:none; background:none; cursor:pointer; color: var(--danger); font-size: 1.2rem;"><i class="bi bi-trash-fill"></i></button>
                </td>
            </tr>
        `;
        tableBody.innerHTML += row;
    });
});
</script>
</body>
</html>
<%- include('partials/footer') %>