<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StockEx - Relatórios</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar') %>

        <header class="header">
            <h1 class="header-title">Relatórios e Análises</h1>
            <div class="user-profile">
                <span>Bem-vindo, João</span>
                <img src="https://i.pravatar.cc/40?u=joao" alt="Avatar">
            </div>
        </header>

        <main class="main-content">
            <div class="reports-grid">
                <div class="report-card">
                    <h3>Movimentações por Mês</h3>
                    <div class="placeholder-chart">Gráfico de Barras (Chart.js)</div>
                </div>
                <div class="report-card">
                    <h3>Itens por Categoria</h3>
                    <div class="placeholder-chart">Gráfico de Pizza (Chart.js)</div>
                </div>
                <div class="report-card">
                    <h3>Valor do Estoque (Histórico)</h3>
                    <div class="placeholder-chart">Gráfico de Linha (Chart.js)</div>
                </div>
                 <div class="report-card">
                    <h3>Curva ABC de Itens</h3>
                    <div class="placeholder-chart">Gráfico de Pareto (Chart.js)</div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>