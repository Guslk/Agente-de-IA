<%- include('partials/header', { title: 'Itens', paginaAtiva: 'itens' }) %>

<%
    // --- Lógica EJS para ajudar a construir os links de ordenação ---
    
    const sortColumn = (typeof currentSort !== 'undefined') ? currentSort.column : 'name';
    const sortOrder = (typeof currentSort !== 'undefined') ? currentSort.order : 'ASC';

    // Pega os filtros atuais para não perdê-los ao ordenar
    const currentFilters = new URLSearchParams(typeof filters !== 'undefined' ? filters : {});
    currentFilters.delete('sort'); // Remove parâmetros de ordenação antigos
    currentFilters.delete('order');
    const filterParams = currentFilters.toString(); // Constrói a string de consulta (ex: &busca=parafuso&status=Ativo)

    // Função para criar a URL de ordenação
    const createSortUrl = (columnName) => {
        let newOrder = 'ASC';
        if (columnName === sortColumn) {
            newOrder = (sortOrder === 'ASC') ? 'DESC' : 'ASC'; // Inverte a ordem
        }
        return `/itens?sort=${columnName}&order=${newOrder}&${filterParams}`;
    };

    // Função para mostrar um ícone (seta)
    const getSortIcon = (columnName) => {
        if (columnName === sortColumn) {
            return (sortOrder === 'ASC') ? ' <i class="bi bi-sort-down"></i>' : ' <i class="bi bi-sort-up"></i>';
        }
        // Adiciona um ícone padrão sutil para colunas não ordenadas (opcional)
        // return ' <i class="bi bi-arrow-down-up" style="opacity: 0.3; font-size: 0.8em;"></i>'; 
        return '';
    };
%>

<header class="header">
    <h1 class="header-title">Itens Cadastrados</h1>
    <!-- Adicionado a parte direita do header para consistência -->
    <div class="header-right">
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.nome || user.name %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar" class="avatar-img">
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">
    
    <div class="main-header">
        <h2>Catálogo de Itens</h2>
        <div class="action-buttons">
            <!-- Botões com classes corretas -->
            <button class="btn-primary" id="btn-show-add-modal" style="background-color: var(--success);"><i class="bi bi-plus-circle-fill"></i> Adicionar Novo Item</button>
            <button class="btn-secondary" id="btn-show-dpto-modal"><i class="bi bi-gear-fill"></i> Gerenciar Departamentos</button>
        </div>
    </div>
    
    <!-- Filtros com classes corretas -->
    <section class="filter-section">
        <form action="/itens" method="GET" class="filter-form"> 
            <div class="form-group">
                <label for="filter-busca">Nome do Item</label>
                <input type="text" id="filter-busca" name="busca" placeholder="Buscar por nome..." value="<%= filters.busca || '' %>">
            </div>
            <div class="form-group">
                <label for="filter-code">Código</label>
                <input type="text" id="filter-code" name="code" placeholder="Buscar por código..." value="<%= filters.code || '' %>">
            </div>
            <div class="form-group">
                <label for="filter-position">Localização</label>
                <input type="text" id="filter-position" name="position" placeholder="Buscar por localização..." value="<%= filters.position || '' %>">
            </div>
            <div class="form-group">
                <label for="filter-status">Status do Item</label>
                <select id="filter-status" name="status">
                    <option value="todos" <%= (!filters.status || filters.status === 'todos') ? 'selected' : '' %>>Todos</option>
                    <option value="Ativo" <%= (filters.status === 'Ativo') ? 'selected' : '' %>>Apenas Ativos</option>
                    <option value="Desativado" <%= (filters.status === 'Desativado') ? 'selected' : '' %>>Apenas Desativados</option>
                </select>
            </div>
            <div class="form-group">
                <label for="filter-stock-status">Status do Estoque</label>
                <select id="filter-stock-status" name="filtroStatus">
                    <option value="todos" <%= (!filters.filtroStatus || filters.filtroStatus === 'todos') ? 'selected' : '' %>>Todos os Níveis</option>
                    <option value="normal" <%= (filters.filtroStatus === 'normal') ? 'selected' : '' %>>Estoque Normal</option>
                    <option value="baixo" <%= (filters.filtroStatus === 'baixo') ? 'selected' : '' %>>Estoque Baixo</option>
                    <option value="esgotado" <%= (filters.filtroStatus === 'esgotado') ? 'selected' : '' %>>Esgotado</option>
                </select>
            </div>
            <button type="submit" class="btn-primary" style="align-self: end;"><i class="bi bi-search"></i> Filtrar</button>
        </form>
    </section>

    <!-- Tabela Principal com classes corretas -->
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th><a href="<%= createSortUrl('code') %>">Código<%- getSortIcon('code') %></a></th>
                    <th><a href="<%= createSortUrl('name') %>">Nome<%- getSortIcon('name') %></a></th>
                    <th><a href="<%= createSortUrl('description') %>">Descrição<%- getSortIcon('description') %></a></th>
                    <th><a href="<%= createSortUrl('quantity') %>">Qtd. Atual<%- getSortIcon('quantity') %></a></th>
                    <th><a href="<%= createSortUrl('minimumQuantity') %>">Qtd. Mínima<%- getSortIcon('minimumQuantity') %></a></th>
                    <th><a href="<%= createSortUrl('maximumQuantity') %>">Qtd. Máxima<%- getSortIcon('maximumQuantity') %></a></th>
                    <th><a href="<%= createSortUrl('totalValue') %>"> Valor Total <%- getSortIcon('totalValue') %></a></th>
                    <th><a href="<%= createSortUrl('department') %>">Departamento<%- getSortIcon('department') %></a></th>
                    <th><a href="<%= createSortUrl('position') %>">Localização<%- getSortIcon('position') %></a></th>
                    <th><a href="<%= createSortUrl('status') %>">Status<%- getSortIcon('status') %></a></th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="items-table-body">
                <% if (typeof items !== 'undefined' && items.length > 0) { %>
                    <% items.forEach(item => { %>
                        <%
                            const qtdAtual = Number(item.quantity) || 0;
                            let rowClass = '';
                            if (item.status === 'Desativado') rowClass = 'stock-planned'; // Amarelo para Desativado
                            else if (qtdAtual <= 0) rowClass = 'out-of-stock-row'; // Vermelho para Esgotado
                            else if (qtdAtual < item.minimumQuantity) rowClass = 'low-stock-row'; // Laranja para Baixo
                        %>
                        <tr class="<%= rowClass %>">
                            <td><code><%= item.code %></code></td>
                            <td><strong><%= item.name %></strong></td>
                            <td><%= item.description %></td>
                        <td><%= qtdAtual %></td>
                            <td><%= item.minimumQuantity %></td>
                            <td><%= item.maximumQuantity %></td>
                            <!-- LINHA CORRIGIDA -->
                            <!-- <td><%= (typeof item.totalValue === 'number' && !isNaN(item.totalValue)) ? `R$ ${item.totalValue.toFixed(2)}` : 'N/A' %></td> -->
                                                    <td><%= item.totalValue %></td>
                            <td><%= item.department %></td>
                            <td><%= item.position %></td>
                            <!-- Usando span para status -->
                            <td>
                                <% if (item.status === 'Ativo') { %>
                                    <span class="status-pill status-ok">Ativo</span>
                                <% } else { %>
                                    <span class="status-pill status-low">Desativado</span>
                                <% } %>
                            </td>
                            <td>
                                <!-- Botões de ação com classes corretas -->
                                <button title="Editar" class="action-btn btn-edit" data-item='<%- JSON.stringify(item) %>'><i class="bi bi-pencil-square"></i></button>
                                <form action="/itens/<%= item.id %>/deletar" method="POST" style="display: inline;" onsubmit="return confirm('Você tem certeza que deseja excluir este item?');">
                                    <button type="submit" title="Excluir" class="action-btn danger"><i class="bi bi-trash-fill"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="11" style="text-align: center;">Nenhum item encontrado para os filtros selecionados.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>

    <!-- Tabela de Itens Excluídos (Lixeira) -->
    <div class="main-header" style="margin-top: 40px;">
        <h2>Itens Excluídos (Lixeira)</h2>
        <div class="action-buttons">
            <button class="btn-secondary" id="btn-toggle-excluded">
                <i class="bi bi-eye-fill"></i> Mostrar Lixeira
            </button>
        </div>
    </div>
    
    <section class="inventory-table" id="excluded-items-table" style="display: none;">
        <table>
            <thead>
                <tr>
                    <th>Nome do Item</th>
                    <th>Departamento</th> <!-- Corrigido: Era 'Estoque' -->
                    <th>Status</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof excludedItems !== 'undefined' && excludedItems.length > 0) { %>
                    <% excludedItems.forEach(item => { %>
                        <tr style="opacity: 0.7; background-color: #f8f9fa;">
                            <td><strong><%= item.name %></strong></td>
                            <!-- Assumindo que a relação se chama 'department' ou similar -->
                            <td><%= item.department || 'N/A' %></td>
                            <td><span class="status-pill status-empty"><%= item.status %></span></td>
                            <td>
                                <form action="/itens/<%= item.id %>/restore" method="POST" style="display: inline;">
                                    <!-- Botão Restaurar com classe -->
                                    <button type="submit" title="Restaurar Item" class="action-btn restore-btn" style="color: var(--success);">
                                        <i class="bi bi-arrow-counterclockwise"></i> Restaurar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="4" style="text-align: center;">Lixeira está vazia.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>

</main>

<!-- Modal de Adicionar Item -->
<div class="modal-overlay" id="add-item-modal">
    <div class="modal"> <!-- Tamanho padrão -->
        <div class="modal-header">
            <h3>Adicionar Novo Item</h3>
            <button class="close-button" id="btn-close-add-modal">&times;</button>
        </div>
        <form action="/itens" method="POST">
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group"><label for="nome">Nome do Item</label><input type="text" id="nome" name="nome" required></div>
                    <div class="form-group"><label for="codigo_barras">Código de Barras</label><input type="text" id="codigo_barras" name="codigo_barras"></div>
                    <div class="form-group"><label for="quantidade_minima">Quantidade Mínima</label><input type="number" id="quantidade_minima" name="quantidade_minima" value="0" min="0" required></div>
                    <div class="form-group"><label for="maximumQuantity">Quantidade Máxima</label><input type="number" id="maximumQuantity" name="maximumQuantity" min="0"></div>
                    <div class="form-group"><label for="unidade_medida">Unidade de Medida</label><select id="unidade_medida" name="unidade_medida"><select id="edit-unidade_medida" name="unidade_medida"><option value="un">Unidade</option><option value="cx">Caixa</option><option value="kg">Kg</option><option value="l">Litro</option></select></div>
                    <div class="form-group full-width"><label for="descricao">Descrição</label><input type="text" id="descricao" name="descricao"></div>
                </div>
                <hr class="form-divider">
                <h4>Estoque e Localização</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="id_stock">Departamento</label> <!-- Mudado de Estoque para Departamento -->
                        <select id="id_stock" name="id_stock" required>
                            <option value="">Selecione...</option>
                            <% if (typeof stocks !== 'undefined' && stocks.length > 0) { %>
                                <% stocks.forEach(stock => { %>
                                    <option value="<%= stock.id %>"><%= stock.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group"><label for="loc_corredor">Corredor</label><input type="text" id="loc_corredor" name="loc_corredor" placeholder="Ex: A"></div>
                    <div class="form-group"><label for="loc_prateleira">Prateleira</label><input type="text" id="loc_prateleira" name="loc_prateleira" placeholder="Ex: 04"></div>
                    <div class="form-group"><label for="loc_posicao">Posição</label><input type="text" id="loc_posicao" name="loc_posicao" placeholder="Ex: 15"></div>
                </div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Salvar Item</button></div>
        </form>
    </div>
</div>

<!-- Modal de Gerenciar Departamentos -->
<div class="modal-overlay" id="dpto-modal">
    <div class="modal" style="max-width: 500px;">
        <div class="modal-header">
            <h3>Gerenciar Departamentos</h3>
            <button class="close-button" id="btn-close-dpto-modal">&times;</button>
        </div>
        <div class="modal-body">
            <h4>Departamentos Atuais</h4>
            <!-- Lista com estilo a ser definido ou usar tabela -->
            <ul style="list-style: none; padding: 0; margin-bottom: 20px;">
                <% if(typeof stocks !== 'undefined' && stocks.length > 0) { %>
                    <% stocks.forEach(stock => { %>
                        <li style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border-color);">
                            <span><%= stock.name %></span>
                            <form action="/stocks/<%= stock.id %>/delete" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este departamento? Itens associados não serão excluídos.');" style="margin: 0;">
                                <button type="submit" class="action-btn danger" title="Excluir Departamento"><i class="bi bi-trash-fill"></i></button>
                            </form>
                        </li>
                    <% }); %>
                <% } else { %>
                    <li style="color: var(--text-light);">Nenhum departamento cadastrado.</li>
                <% } %>
            </ul>
            <hr class="form-divider">
            <h4 style="margin-top: 20px;">Adicionar Novo Departamento</h4>
            <form action="/stocks" method="POST" class="filter-form" style="margin-top: 10px;">
                <div class="form-group">
                    <label for="stock-name">Nome do Departamento</label>
                    <input type="text" id="stock-name" name="name" required>
                </div>
                <button type="submit" class="btn-primary" style="align-self: end;">Adicionar</button>
            </form>
        </div>
    </div>
</div>

<!-- Modal de Editar Item -->
<div class="modal-overlay" id="edit-item-modal">
    <div class="modal"> <!-- Tamanho padrão -->
        <div class="modal-header">
            <h3>Editar Item</h3>
            <button class="close-button" id="btn-close-edit-modal">&times;</button>
        </div>
        <form id="edit-form" method="POST"> <!-- Action definida via JS -->
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group"><label for="edit-nome">Nome do Item</label><input type="text" id="edit-nome" name="nome" required></div>
                    <div class="form-group"><label for="edit-codigo_barras">Código de Barras</label><input type="text" id="edit-codigo_barras" name="codigo_barras"></div>
                    <div class="form-group"><label for="edit-quantidade_minima">Quantidade Mínima</label><input type="number" id="edit-quantidade_minima" name="quantidade_minima" min="0" required></div>
                    <div class="form-group"><label for="edit-maximumQuantity">Quantidade Máxima</label><input type="number" id="edit-maximumQuantity" name="maximumQuantity" min="0"></div>
                    <div class="form-group"><label for="edit-unidade_medida">Unidade de Medida</label><select id="edit-unidade_medida" name="unidade_medida"><option value="un">Unidade</option><option value="cx">Caixa</option><option value="kg">Kg</option><option value="l">Litro</option></select></div>
                    <div class="form-group">
                        <label for="edit-status">Status</label>
                        <select id="edit-status" name="status" required>
                            <option value="Ativo">Ativo</option>
                            <option value="Desativado">Desativado</option>
                        </select>
                    </div>
                    <div class="form-group full-width"><label for="edit-descricao">Descrição</label><input type="text" id="edit-descricao" name="descricao"></div>
                </div>
                <hr class="form-divider">
                <h4>Estoque e Localização</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="edit-id_stock">Departamento</label> <!-- Mudado de Estoque para Departamento -->
                        <select id="edit-id_stock" name="id_stock" required>
                            <option value="">Selecione...</option>
                            <% if (typeof stocks !== 'undefined' && stocks.length > 0) { %>
                                <% stocks.forEach(stock => { %>
                                    <option value="<%= stock.id %>"><%= stock.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group"><label for="edit-loc_corredor">Corredor</label><input type="text" id="edit-loc_corredor" name="loc_corredor"></div>
                    <div class="form-group"><label for="edit-loc_prateleira">Prateleira</label><input type="text" id="edit-loc_prateleira" name="loc_prateleira"></div>
                    <div class="form-group"><label for="edit-loc_posicao">Posição</label><input type="text" id="edit-loc_posicao" name="loc_posicao"></div>
                </div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Salvar Alterações</button></div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<!-- Script JS existente (IDs foram mantidos) -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
    // Lógica para o modal de ADICIONAR
    const addModal = document.getElementById('add-item-modal');
    const btnShowAddModal = document.getElementById('btn-show-add-modal');
    const btnCloseAddModal = document.getElementById('btn-close-add-modal');
    if(addModal && btnShowAddModal && btnCloseAddModal) {
        btnShowAddModal.addEventListener('click', () => addModal.style.display = 'flex');
        btnCloseAddModal.addEventListener('click', () => addModal.style.display = 'none');
        window.addEventListener('click', (event) => { if (event.target === addModal) addModal.style.display = 'none'; });
    }

    // Lógica para o modal de DEPARTAMENTOS (Estoques)
    const dptoModal = document.getElementById('dpto-modal');
    const btnShowDptoModal = document.getElementById('btn-show-dpto-modal');
    const btnCloseDptoModal = document.getElementById('btn-close-dpto-modal');
    if (dptoModal && btnShowDptoModal && btnCloseDptoModal) {
        btnShowDptoModal.addEventListener('click', () => dptoModal.style.display = 'flex');
        btnCloseDptoModal.addEventListener('click', () => dptoModal.style.display = 'none');
        window.addEventListener('click', (event) => { if (event.target === dptoModal) dptoModal.style.display = 'none'; });
    }

    // Lógica para o modal de EDITAR
    const editModal = document.getElementById('edit-item-modal');
    const btnCloseEditModal = document.getElementById('btn-close-edit-modal');
    const editForm = document.getElementById('edit-form');
    const btnsEdit = document.querySelectorAll('.btn-edit');
    if(editModal && btnCloseEditModal && editForm && btnsEdit.length > 0) {
        btnsEdit.forEach(btn => {
            btn.addEventListener('click', () => {
                try {
                    const item = JSON.parse(btn.dataset.item);
                    editForm.action = `/itens/${item.id}/atualizar`;
                    
                    // Preenche campos simples
                    document.getElementById('edit-nome').value = item.name || '';
                    document.getElementById('edit-codigo_barras').value = item.code || '';
                    document.getElementById('edit-quantidade_minima').value = item.minimumQuantity || 0;
                    document.getElementById('edit-maximumQuantity').value = item.maximumQuantity || '';
                    document.getElementById('edit-unidade_medida').value = item.unitOfMeasure || 'unidade';
                    document.getElementById('edit-status').value = item.status || 'Ativo';
                    document.getElementById('edit-descricao').value = item.description || '';
                    document.getElementById('edit-id_stock').value = item.id_stock || '';

                    // Preenche localização (tratando caso seja null ou não tenha '-')
                    const positionString = item.position || '';
                    const [corredor = '', prateleira = '', posicao = ''] = positionString.split('-');
                    document.getElementById('edit-loc_corredor').value = corredor;
                    document.getElementById('edit-loc_prateleira').value = prateleira;
                    document.getElementById('edit-loc_posicao').value = posicao;

                    editModal.style.display = 'flex';
                } catch (e) {
                     console.error("Erro ao processar dados do item para edição:", e, btn.dataset.item);
                     alert("Erro ao carregar dados do item para edição.");
                }
            });
        });
        btnCloseEditModal.addEventListener('click', () => editModal.style.display = 'none');
        window.addEventListener('click', (event) => { if (event.target === editModal) editModal.style.display = 'none'; });
    }

    // Lógica para o botão "Mostrar Lixeira"
    const btnToggleExcluded = document.getElementById('btn-toggle-excluded');
    const excludedTable = document.getElementById('excluded-items-table');
    if (btnToggleExcluded && excludedTable) {
        btnToggleExcluded.addEventListener('click', () => {
            const isHidden = excludedTable.style.display === 'none';
            if (isHidden) {
                // Correção: Usar 'block' para <section> ou 'table' se fosse direto no <table>
                excludedTable.style.display = 'block'; 
                btnToggleExcluded.innerHTML = '<i class="bi bi-eye-slash-fill"></i> Ocultar Lixeira';
                btnToggleExcluded.classList.remove('btn-secondary');
                // Adiciona btn-danger para cor vermelha (ou outra de sua escolha)
                btnToggleExcluded.classList.add('btn-primary'); 
                 btnToggleExcluded.style.backgroundColor = 'var(--danger)'; // Cor vermelha
            } else {
                excludedTable.style.display = 'none';
                btnToggleExcluded.innerHTML = '<i class="bi bi-eye-fill"></i> Mostrar Lixeira';
                btnToggleExcluded.classList.remove('btn-primary');
                btnToggleExcluded.style.backgroundColor = ''; // Remove cor inline
                btnToggleExcluded.classList.add('btn-secondary'); // Volta para cor secundária
            }
        });
    }
});
</script>

<style>
    .inventory-table th a {
        color: inherit; /* Usa a cor padrão do texto do cabeçalho */
        text-decoration: none; /* Remove o sublinhado */
        display: block; /* Garante que o link ocupe toda a célula */
        width: 100%;
        transition: color 0.2s ease; /* Adiciona uma transição suave */
    }
    .inventory-table th a:hover {
        color: var(--primary-color); /* Muda a cor ao passar o mouse (opcional) */
         /* text-decoration: underline; */ /* Adiciona sublinhado ao passar o mouse (opcional) */
    }
     .inventory-table th a i {
         /* Ajusta ligeiramente a aparência do ícone de ordenação */
        font-size: 0.9em;
        opacity: 0.7;
     }
</style>

