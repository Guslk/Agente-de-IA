<%- include('partials/header', { title: 'Itens', paginaAtiva: 'itens' }) %>

<header class="header">
    <h1 class="header-title">Itens Cadastrados</h1>
    <div class="header-right">
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.name %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar">
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Catálogo de Itens</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-show-add-modal"><i class="bi bi-plus-circle-fill"></i> Adicionar Novo Item</button>
        </div>
    </div>
    
    <section class="filter-section">
        <form action="/itens" method="GET" class="filter-form">
            <div class="form-group">
                <input type="text" name="busca" placeholder="Buscar por nome do item..." value="<%= typeof busca !== 'undefined' ? busca : '' %>">
            </div>
            <div class="form-group">
                <select name="filtroStatus">
                    <option value="todos" <%= (typeof filtroStatus !== 'undefined' && filtroStatus === 'todos') ? 'selected' : '' %>>Todos os Status</option>
                    <option value="normal" <%= (typeof filtroStatus !== 'undefined' && filtroStatus === 'normal') ? 'selected' : '' %>>Estoque Normal</option>
                    <option value="baixo" <%= (typeof filtroStatus !== 'undefined' && filtroStatus === 'baixo') ? 'selected' : '' %>>Estoque Baixo</option>
                    <option value="esgotado" <%= (typeof filtroStatus !== 'undefined' && filtroStatus === 'esgotado') ? 'selected' : '' %>>Esgotado</option>
                </select>
            </div>
            <button type="submit" class="btn-primary"><i class="bi bi-search"></i> Filtrar</button>
        </form>
    </section>

    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Nome do Item</th>
                    <th>Qtd. Atual</th>
                    <th>Departamento</th>
                    <th>Localização</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="items-table-body">
                <% if (typeof items !== 'undefined' && items.length > 0) { %>
                    <% items.forEach(item => { %>
                        <%
                            const qtdAtual = Number(item.quantidade_atual) || 0;
                            let rowClass = '';
                            if (qtdAtual <= 0) {
                                rowClass = 'out-of-stock-row';
                            } else if (qtdAtual < item.minimumQuantity) {
                                rowClass = 'low-stock-row';
                            }
                        %>
                        <tr class="<%= rowClass %>">
                            <td><strong><%= item.name %></strong></td>
                            <td><%= qtdAtual %></td>
                            <td><%= item.department %></td>
                            <td><%= item.position %></td>
                            <td>
                                <button title="Editar" class="action-btn btn-edit" data-item='<%- JSON.stringify(item) %>'><i class="bi bi-pencil-square"></i></button>
                                <form action="/itens/<%= item.id %>/deletar" method="POST" style="display: inline;" onsubmit="return confirm('Você tem certeza que deseja excluir este item?');">
                                    <button type="submit" title="Excluir" class="action-btn danger"><i class="bi bi-trash-fill"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="5" style="text-align: center;">Nenhum item encontrado.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<div class="modal-overlay" id="add-item-modal">
    <div class="modal">
        <div class="modal-header">
            <h3>Adicionar Novo Item ao Estoque</h3>
            <button class="close-button" id="btn-close-add-modal">&times;</button>
        </div>
        <form action="/itens" method="POST">
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group"><label for="nome">Nome do Item</label><input type="text" id="nome" name="nome" required></div>
                    <div class="form-group"><label for="codigo_barras">Código de Barras</label><input type="text" id="codigo_barras" name="codigo_barras"></div>
                    <div class="form-group"><label for="quantidade_minima">Quantidade Mínima</label><input type="number" id="quantidade_minima" name="quantidade_minima" value="0" min="0" required></div>
                    <div class="form-group"><label for="unidade_medida">Unidade de Medida</label><select id="unidade_medida" name="unidade_medida"><option value="unidade">Unidade</option><option value="caixa">Caixa</option><option value="kg">Kg</option></select></div>
                    <div class="form-group"><label for="descricao">Descrição (Opcional)</label><input type="text" id="descricao" name="descricao" class="full-width"></div>
                </div>
                <hr style="margin: 20px 0;">
                <h4>Estoque e Localização</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="id_stock">Estoque</label>
                        <select id="id_stock" name="id_stock" required>
                            <option value="">Selecione um estoque...</option>
                            <% if (typeof stocks !== 'undefined' && stocks.length > 0) { %>
                                <% stocks.forEach(stock => { %>
                                    <option value="<%= stock.id_stock %>"><%= stock.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group"><label for="loc_corredor">Corredor</label><input type="text" id="loc_corredor" name="loc_corredor" placeholder="Ex: A"></div>
                    <div class="form-group"><label for="loc_prateleira">Prateleira</label><input type="text" id="loc_prateleira" name="loc_prateleira" placeholder="Ex: 04"></div>
                    <div class="form-group"><label for="loc_posicao">Posição</label><input type="text" id="loc_posicao" name="loc_posicao" placeholder="Ex: 15"></div>
                </div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Salvar Item</button></div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="edit-item-modal">
    <div class="modal">
        <div class="modal-header"><h3>Editar Item</h3><button class="close-button" id="btn-close-edit-modal">&times;</button></div>
        <form id="edit-form" method="POST">
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group"><label for="edit-nome">Nome do Item</label><input type="text" id="edit-nome" name="nome" required></div>
                    <div class="form-group"><label for="edit-codigo_barras">Código de Barras</label><input type="text" id="edit-codigo_barras" name="codigo_barras"></div>
                    <div class="form-group"><label for="edit-quantidade_minima">Quantidade Mínima</label><input type="number" id="edit-quantidade_minima" name="quantidade_minima" min="0" required></div>
                    <div class="form-group"><label for="edit-unidade_medida">Unidade de Medida</label><select id="edit-unidade_medida" name="unidade_medida"><option value="unidade">Unidade</option><option value="caixa">Caixa</option><option value="kg">Kg</option></select></div>
                    <div class="form-group"><label for="edit-descricao">Descrição (Opcional)</label><input type="text" id="edit-descricao" name="descricao" class="full-width"></div>
                </div>
                <hr style="margin: 20px 0;">
                <h4>Estoque e Localização</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="edit-id_stock">Estoque</label>
                        <select id="edit-id_stock" name="id_stock" required>
                            <option value="">Selecione um estoque...</option>
                            <% if (typeof stocks !== 'undefined' && stocks.length > 0) { %>
                                <% stocks.forEach(stock => { %>
                                    <option value="<%= stock.id_stock %>"><%= stock.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group"><label for="edit-loc_corredor">Corredor</label><input type="text" id="edit-loc_corredor" name="loc_corredor"></div>
                    <div class="form-group"><label for="edit-loc_prateleira">Prateleira</label><input type="text" id="edit-loc_prateleira" name="loc_prateleira"></div>
                    <div class="form-group"><label for="edit-loc_posicao">Posição</label><input type="text" id="edit-loc_posicao" name="loc_posicao"></div>
                </div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Salvar Alterações</button></div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Lógica para o modal de ADICIONAR (permanece a mesma)
    const addModal = document.getElementById('add-item-modal');
    const btnShowAddModal = document.getElementById('btn-show-add-modal');
    const btnCloseAddModal = document.getElementById('btn-close-add-modal');
    if(btnShowAddModal) btnShowAddModal.addEventListener('click', () => addModal.style.display = 'flex');
    if(btnCloseAddModal) btnCloseAddModal.addEventListener('click', () => addModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === addModal) addModal.style.display = 'none'; });

    // Lógica para o modal de EDITAR (agora vai funcionar)
    const editModal = document.getElementById('edit-item-modal');
    const btnCloseEditModal = document.getElementById('btn-close-edit-modal');
    const editForm = document.getElementById('edit-form');
    const btnsEdit = document.querySelectorAll('.btn-edit');

    btnsEdit.forEach(btn => {
        btn.addEventListener('click', () => {
            const item = JSON.parse(btn.dataset.item);

            // Define a 'action' do formulário para a rota de atualização correta
            editForm.action = `/itens/${item.id}/atualizar`;

            // Preenche os campos do formulário com os dados do item
            document.getElementById('edit-nome').value = item.name;
            document.getElementById('edit-codigo_barras').value = item.code;
            document.getElementById('edit-quantidade_minima').value = item.minimumQuantity;
            document.getElementById('edit-unidade_medida').value = item.unitOfMeasure;
            document.getElementById('edit-descricao').value = item.description;
            document.getElementById('edit-id_stock').value = item.id_stock;

            // Separa a 'position' para preencher os 3 inputs de localização
            const [corredor = '', prateleira = '', posicao = ''] = item.position.split('-');
            document.getElementById('edit-loc_corredor').value = corredor;
            document.getElementById('edit-loc_prateleira').value = prateleira;
            document.getElementById('edit-loc_posicao').value = posicao;

            // Mostra o modal de edição
            editModal.style.display = 'flex';
        });
    });

    if(btnCloseEditModal) btnCloseEditModal.addEventListener('click', () => editModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === editModal) editModal.style.display = 'none'; });
});
</script>