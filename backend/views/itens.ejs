<%- include('partials/header', { title: 'Itens', paginaAtiva: 'itens' }) %>

<header class="header">
    <h1 class="header-title">Gerenciamento de Itens</h1>
    <div class="user-profile">
        <span>Bem-vindo, João</span>
        <img src="https://i.pravatar.cc/40?u=joao" alt="Avatar">
    </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Todos os Itens Cadastrados</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-novo-item"><i class="bi bi-plus-circle-fill"></i> Adicionar Novo Item</button>
        </div>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Nome do Item</th>
                    <th>Código de Barras</th>
                    <th>Qtd. Atual</th>
                    <th>Unidade</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="items-table-body">
                <% if (typeof items !== 'undefined' && items.length > 0) { %>
                    <% items.forEach(item => { %>
                        <tr>
                            <td><strong><%= item.nome %></strong></td>
                            <td><%= item.codigo_barras %></td>
                            <td><%= item.quantidade_atual %></td>
                            <td><%= item.unidade_medida %></td>
                            <td>
                                <button title="Editar" class="action-btn"><i class="bi bi-pencil-square"></i></button>
                                <button title="Excluir" class="action-btn danger"><i class="bi bi-trash-fill"></i></button>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="text-align: center;">Nenhum item encontrado.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<div class="modal-overlay" id="add-item-modal">
    <div class="modal">
        <div class="modal-header">
            <h3>Adicionar Novo Item ao Estoque</h3>
            <button class="close-button" id="btn-close-modal">&times;</button>
        </div>
        <form action="/itens/novo" method="POST">
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="nome">Nome do Item</label>
                        <input type="text" id="nome" name="nome" required>
                    </div>
                    <div class="form-group">
                        <label for="codigo_barras">Código de Barras</label>
                        <input type="text" id="codigo_barras" name="codigo_barras">
                    </div>
                    <div class="form-group">
                        <label for="quantidade_atual">Quantidade Inicial</label>
                        <input type="number" id="quantidade_atual" name="quantidade_atual" value="0" min="0" required>
                    </div>
                    <div class="form-group">
                        <label for="quantidade_minima">Quantidade Mínima</label>
                        <input type="number" id="quantidade_minima" name="quantidade_minima" value="0" min="0" required>
                    </div>
                    <div class="form-group">
                        <label for="unidade_medida">Unidade de Medida</label>
                        <select id="unidade_medida" name="unidade_medida">
                            <option value="unidade">Unidade</option>
                            <option value="caixa">Caixa</option>
                            <option value="kg">Kg</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="descricao">Descrição (Opcional)</label>
                        <input type="text" id="descricao" name="descricao">
                    </div>
                </div>
                <hr style="margin: 20px 0;">
                <h4>Informações da Entrada</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="nota_fiscal_codigo">Código da Nota Fiscal</label>
                        <input type="text" id="nota_fiscal_codigo" name="nota_fiscal_codigo">
                    </div>
                    <div class="form-group">
                        <label for="nota_fiscal_link">Link do PDF da Nota (Drive)</label>
                        <input type="url" id="nota_fiscal_link" name="nota_fiscal_link" placeholder="https://drive.google.com/...">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn-primary">Salvar Item</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('add-item-modal');
    const btnNovoItem = document.getElementById('btn-novo-item');
    const btnCloseModal = document.getElementById('btn-close-modal');

    // Abre o modal ao clicar no botão "Adicionar Novo Item"
    if(btnNovoItem) {
        btnNovoItem.addEventListener('click', () => {
            modal.style.display = 'flex';
        });
    }

    // Fecha o modal ao clicar no 'X'
    if(btnCloseModal) {
        btnCloseModal.addEventListener('click', () => {
            modal.style.display = 'none';
        });
    }

    // Fecha o modal se o usuário clicar fora da caixa branca
    window.addEventListener('click', (event) => {
        if (event.target === modal) {
            modal.style.display = 'none';
        }
    });
});
</script>