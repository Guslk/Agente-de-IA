<%- include('partials/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
    // Lógica para o modal de ADICIONAR (permanece a mesma)
    const addModal = document.getElementById('add-item-modal');
    const btnShowAddModal = document.getElementById('btn-show-add-modal');
    const btnCloseAddModal = document.getElementById('btn-close-add-modal');
    if(btnShowAddModal) btnShowAddModal.addEventListener('click', () => addModal.style.display = 'flex');
    if(btnCloseAddModal) btnCloseAddModal.addEventListener('click', () => addModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === addModal) addModal.style.display = 'none'; });


// Lógica para o modal de DEPARTAMENTOS (Estoques)
const dptoModal = document.getElementById('dpto-modal');
const btnShowDptoModal = document.getElementById('btn-show-dpto-modal'); // Mantém o ID do seu botão
const btnCloseDptoModal = document.getElementById('btn-close-dpto-modal');

if (btnShowDptoModal) btnShowDptoModal.addEventListener('click', () => dptoModal.style.display = 'flex');
if (btnCloseDptoModal) btnCloseDptoModal.addEventListener('click', () => dptoModal.style.display = 'none');
window.addEventListener('click', (event) => { 
    if (event.target === dptoModal) dptoModal.style.display = 'none'; 
});
// Lógica para o modal de EDITAR (agora vai funcionar)
    const editModal = document.getElementById('edit-item-modal');
    const btnCloseEditModal = document.getElementById('btn-close-edit-modal');
    const editForm = document.getElementById('edit-form');
    const btnsEdit = document.querySelectorAll('.btn-edit');
btnsEdit.forEach(btn => {
        btn.addEventListener('click', () => {
            const item = JSON.parse(btn.dataset.item);

            // Define a 'action' do formulário para a rota de atualização correta
            editForm.action = `/itens/${item.id}/atualizar`;

            // Preenche os campos do formulário com os dados do item
            document.getElementById('edit-nome').value = item.name;
            document.getElementById('edit-codigo_barras').value = item.code;
            document.getElementById('edit-quantidade_minima').value = item.minimumQuantity;
            document.getElementById('edit-unidade_medida').value = item.unitOfMeasure;
            document.getElementById('edit-id_stock').value = item.id_stock;
                                    document.getElementById('edit-maximumQuantity').value = item.maximumQuantity;
                                    document.getElementById('edit-descricao').value = item.description;
            document.getElementById('edit-status').value = item.status;

            // Separa a 'position' para preencher os 3 inputs de localização
            const [corredor = '', prateleira = '', posicao = ''] = item.position.split('-');
            document.getElementById('edit-loc_corredor').value = corredor;
            document.getElementById('edit-loc_prateleira').value = prateleira;
            document.getElementById('edit-loc_posicao').value = posicao;

            // Mostra o modal de edição
            editModal.style.display = 'flex';
        });
    });

    if(btnCloseEditModal) btnCloseEditModal.addEventListener('click', () => editModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === editModal) editModal.style.display = 'none'; });
    

    // Lógica para o botão "Mostrar Lixeira"
    const btnToggleExcluded = document.getElementById('btn-toggle-excluded');
    const excludedTable = document.getElementById('excluded-items-table');

    if (btnToggleExcluded) {
        btnToggleExcluded.addEventListener('click', () => {
            const isHidden = excludedTable.style.display === 'none';
            if (isHidden) {
                excludedTable.style.display = 'block'; // Mostra a tabela
                btnToggleExcluded.innerHTML = '<i class="bi bi-eye-slash-fill"></i> Ocultar Lixeira';
            } else {
                excludedTable.style.display = 'none'; // Oculta a tabela
                btnToggleExcluded.innerHTML = '<i class="bi bi-eye-fill"></i> Mostrar Lixeira';
            }
        });
    }
});
</script>

<style>
    .inventory-table th a {
        color: inherit;
        text-decoration: none;
        display: block;
        width: 100%;
    }
    .inventory-table th a:hover {
        color: #007bff;
    }
    
