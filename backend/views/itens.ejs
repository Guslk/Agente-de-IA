<header class="header">
    <h1 class="header-title">Itens Cadastrados</h1>
    </header>

<main class="main-content">
    
        <div class="main-header">
        <h2>Catálogo de Itens</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-show-add-modal"><i class="bi bi-plus-circle-fill"></i> Adicionar Novo Item</button>
            <button class="btn-secondary" id="btn-show-dpto-modal"><i class="bi bi-gear-fill"></i> Gerenciar Departamentos</button>
        </div>
    </div>
    
        <section class="filter-section">
        <form action="/itens" method="GET" class="filter-form" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
            <div class="form-group">
                <label>Nome do Item</label>
                <input type="text" name="busca" placeholder="Buscar por nome..." value="<%= filters.busca || '' %>">
            </div>
            <div class="form-group">
                <label>Código</label>
                <input type="text" name="code" placeholder="Buscar por código..." value="<%= filters.code || '' %>">
            </div>
            <div class="form-group">
                <label>Localização</label>
                <input type="text" name="position" placeholder="Buscar por localização..." value="<%= filters.position || '' %>">
            </div>
            <div class="form-group">
                <label>Status do Item</label>
                <select name="status">
                    <option value="todos" <%= (!filters.status || filters.status === 'todos') ? 'selected' : '' %>>Ativos/Desativados</option>
                    <option value="Ativo" <%= (filters.status === 'Ativo') ? 'selected' : '' %>>Apenas Ativos</option>
                    <option value="Desativado" <%= (filters.status === 'Desativado') ? 'selected' : '' %>>Apenas Desativados</option>
                </select>
            </div>
            <div class="form-group">
                <label>Status do Estoque</label>
                <select name="filtroStatus">
                    <option value="todos" <%= (!filters.filtroStatus || filters.filtroStatus === 'todos') ? 'selected' : '' %>>Todos os Níveis</option>
                    <option value="normal" <%= (filters.filtroStatus === 'normal') ? 'selected' : '' %>>Estoque Normal</option>
                    <option value="baixo" <%= (filters.filtroStatus === 'baixo') ? 'selected' : '' %>>Estoque Baixo</option>
                    <option value="esgotado" <%= (filters.filtroStatus === 'esgotado') ? 'selected' : '' %>>Esgotado</option>
                </select>
            </div>
            <button type="submit" class="btn-primary" style="align-self: end;"><i class="bi bi-search"></i> Filtrar</button>
        </form>
    </section>

    <section class="inventory-table">
    <table>
        <thead>
            <tr>
                <th><a href="<%= createSortUrl('code') %>">Code <%- getSortIcon('code') %></a></th>
                <th><a href="<%= createSortUrl('name') %>">Nome do Item <%- getSortIcon('name') %></a></th>
                <th><a href="<%= createSortUrl('description') %>">Descrição <%- getSortIcon('description') %></a></th>
                <th><a href="<%= createSortUrl('quantity') %>">Qtd. Atual <%- getSortIcon('quantity') %></a></th>
                <th><a href="<%= createSortUrl('minimumQuantity') %>">Qtd. Mínima <%- getSortIcon('minimumQuantity') %></a></th>
                <th><a href="<%= createSortUrl('maximumQuantity') %>">Qtd. Máxima <%- getSortIcon('maximumQuantity') %></a></th>
                <th><a href="<%= createSortUrl('maximumQuantity') %>"> Valor Total <%- getSortIcon('maximumQuantity') %></a></th>
                <th><a href="<%= createSortUrl('department') %>">Departamento <%- getSortIcon('department') %></a></th>
                <th><a href="<%= createSortUrl('position') %>">Localização <%- getSortIcon('position') %></a></th>
                <th><a href="<%= createSortUrl('status') %>">Status <%- getSortIcon('status') %></a></th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody id="items-table-body">
            <% if (typeof items !== 'undefined' && items.length > 0) { %>
                <% items.forEach(item => { %>
                    <%
                        const qtdAtual = Number(item.quantity) || 0;
                        let rowClass = '';
                        if (item.status === 'Desativado') rowClass = 'stock-planned';
                        else if (qtdAtual <= 0) rowClass = 'out-of-stock-row';
                        else if (qtdAtual < item.minimumQuantity) rowClass = 'low-stock-row';
                    %>
                    <tr class="<%= rowClass %>">
                        <td><code><%= item.code %></code></td>
                        <td><strong><%= item.name %></strong></td>
                        <td><%= item.description %></td>
                        <td><%= qtdAtual %></td>
                        <td><%= item.minimumQuantity %></td>
                        <td><%= item.maximumQuantity %></td>
                        <td><%= item.totalValue %></td>
                        <td><%= item.department %></td>
                        <td><%= item.position %></td>
                        <td><span class="status-badge <%= item.status === 'Ativo' ? 'active' : 'inactive' %>"><%= item.status %></span></td>
                        <td>
                            <button title="Editar" class="action-btn btn-edit" data-item='<%- JSON.stringify(item) %>'><i class="bi bi-pencil-square"></i></button>
                            <form action="/itens/<%= item.id %>/deletar" method="POST" style="display: inline;" onsubmit="return confirm('Você tem certeza que deseja excluir este item?');">
                                <button type="submit" title="Excluir" class="action-btn danger"><i class="bi bi-trash-fill"></i></button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr><td colspan="10" style="text-align: center;">Nenhum item encontrado para os filtros selecionados.</td></tr>
            <% } %>
        </tbody>
    </table>
</section>

        <div class="main-header" style="margin-top: 40px;">
        <h2>Itens Excluídos (Lixeira)</h2>
        <div class="action-buttons">
            <button class="btn-secondary" id="btn-toggle-excluded">
                <i class="bi bi-eye-fill"></i> Mostrar Lixeira
            </button>
        </div>
    </div>
    
    <section class="inventory-table" id="excluded-items-table" style="display: none;">
        <table>
            <thead>
                <tr>
             <th>Departamento</th>
                    <th>Status</th>
                    <th>Ação</th>
                </tr>
            </thead>
<tbody>
                <% if (typeof excludedItems !== 'undefined' && excludedItems.length > 0) { %>
                    <% excludedItems.forEach(item => { %>
                        <tr style="opacity: 0.7; background-color: #f8f9fa;">
                            <td><strong><%= item.name %></strong></td>
                            <td><%= item.stock ? item.stock.name : 'N/A' %></td>
                            <td><span class="status-badge inactive"><%= item.status %></span></td>
                            <td>
                                                                <form action="/itens/<%= item.id %>/restore" method="POST" style="display: inline;">
                                    <button type="submit" title="Restaurar Item" class="action-btn restore-btn">
                                        <i class="bi bi-arrow-counterclockwise"></i> Restaurar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="4" style="text-align: center;">Lixeira está vazia.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>

</main>

<div class="modal-overlay" id="add-item-modal">
