                    <div class="form-group"><label for="maximumQuantity">Quantidade Máxima (Opcional)</label><input type="number" id="maximumQuantity" name="maximumQuantity" min="0"></div>
                    <div class="form-group"><label for="unidade_medida">Unidade de Medida</label><select id="unidade_medida" name="unidade_medida"><option value="unidade">Unidade</option><option value="caixa">Caixa</option><option value="kg">Kg</option></select></div>
                    <div class="form-group full-width"><label for="descricao">Descrição (Opcional)</label><input type="text" id="descricao" name="descricao"></div>
                </div>
                <hr class="form-divider">
                <h4>Estoque e Localização</h4>
