                    <div class="form-group">
                        <label for="id_stock">Estoque</label>
                        <select id="id_stock" name="id_stock" required>
                            <option value="">Selecione um estoque...</option>
                            <% if (typeof stocks !== 'undefined' && stocks.length > 0) { %>
                                <% stocks.forEach(stock => { %>
