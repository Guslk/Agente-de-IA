
<%- include('partials/header', { title: 'Nova Requisição', paginaAtiva: 'requisicoes' }) %>


<header class="header">
    <h1 class="header-title">Nova Requisição de Itens</h1>
    <div class="header-right">
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.name %></span>
                <div class="user-avatar">
    <% if (typeof user !== 'undefined' && user.photo) { %>
        <img src="<%= user.photo %>" alt="Avatar de <%= user.name %>" 
             onerror="this.src='../img/usuario.jpg'">
    <% } else { %>
        <img src="../img/usuario.jpg" alt="Avatar">
    <% } %>
</div>
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">
    
    <div id="alert-container"></div> 

    <div class="form-container" style="max-width: 900px; margin: auto;">
        <form id="requisition-form">
            <div class="modal-body">
                <section class="form-section">
                    <div class="section-header">
                        <div class="step-indicator">1</div>
                        <h3>Adicionar Itens</h3>
                    </div>
                    
                    <div class="form-group">
                        <label for="search-item-name">Buscar Item Ativo</label>
                        <div class="input-with-button">
                            <input type="text" id="selected-item-name" placeholder="Nenhum item selecionado" readonly class="form-control-readonly">
                            <button type="button" class="btn-secondary btn-lookup" id="btn-open-search-modal">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                        </div>
                        <input type="hidden" id="selected-item-id"> 
                        <input type="hidden" id="selected-item-unit"> 
                    </div>
                    
                    <div class="form-group">
                        <label for="search-item-qty">Quantidade a Requisitar</label>
                        <div class="input-with-button">
                            <input type="number" id="search-item-qty" placeholder="Qtd." min="0.01" step="0.01">
                            <button type="button" class="btn-primary" id="btn-add-item-to-cart" style="width: 120px;">
                                <i class="bi bi-plus"></i> Adicionar
                            </button>
                        </div>
                        <div id="quantity-info" style="margin-top: 0.5rem; font-size: 0.875rem; color: #64748b;"></div>
                    </div>
                </section>

                <div class="section-divider"></div>
                
                <section class="form-section">
                    <div class="section-header">
                        <div class="step-indicator">2</div>
                        <h3>Itens na Requisição (Carrinho)</h3>
                    </div>
                    <section class="inventory-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Quantidade</th>
                                    <th>Ação</th>
                                </tr>
                            </thead>
                            <tbody id="cart-items-body">
                                <tr><td colspan="3" style="text-align: center;">Nenhum item adicionado.</td></tr>
                            </tbody>
                        </table>
                    </section>
                </section>

                <div class="section-divider"></div>
                
<section class="form-section">
    <div class="section-header">
        <div class="step-indicator">3</div>
        <h3>Finalizar (Motivo da Requisição)</h3>
    </div>
    
    <div class="form-group">
        <label>Motivo (Obrigatório)</label>
        <div style="display: flex; gap: 20px; margin-bottom: 1rem;">
            <label style="display: flex; align-items: center; gap: 5px;">
                <input type="radio" name="requestType" value="justificativa" checked> Justificativa
            </label>
            <label style="display: flex; align-items: center; gap: 5px;">
                <input type="radio" name="requestType" value="op"> Ordem de Produção (OP)
            </label>
        </div>
    </div>

    <div class="form-group" id="justificativa-group">
        <label for="justificativa">Justificativa</label>
        <textarea name="justificativa" id="justificativa" rows="3" placeholder="Descreva o motivo da requisição (ex: manutenção, uso interno, projeto X...)"></textarea>
    </div>

    <div class="form-group" id="op-group" style="display: none;">
        <label for="op">Número da OP</label>
        <input type="text" name="op" id="op" placeholder="Insira o número da Ordem de Produção...">
    </div>
</section>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn-primary btn-submit">
                    <i class="bi bi-send"></i> Enviar Requisição
                </button>
            </div>
        </form>
    </div>
</main>

<div class="modal-overlay" id="item-search-modal">
    <div class="modal" style="max-width: 600px;">
        <div class="modal-header">
            <h3>Buscar Item Ativo</h3>
            <button class="close-button" id="btn-close-search-modal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label for="item-search-input">Buscar por Nome ou Código</label>
                <input type="text" id="item-search-input" placeholder="Comece a digitar para filtrar a lista..." autocomplete="off">
            </div>
            <div class="search-results-list" id="item-search-results">
                <div class="result-item" style="text-align: center; color: #64748b; padding: 2rem;">
                    Digite para buscar itens...
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

