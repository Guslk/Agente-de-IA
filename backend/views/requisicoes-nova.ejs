<script>
    // --- Funções Auxiliares (Definições) ---
    // (Podem ficar fora do DOMContentLoaded pois são apenas definições)

    function formatQuantity(quantity, unitOfMeasure) {
        if (!quantity) return '0';
        const qty = parseFloat(quantity);
        const effectiveUnit = unitOfMeasure || 'un';
        
        if (['kg', 'g', 'ton', 'l', 'ml'].includes(effectiveUnit)) {
            return qty.toFixed(2);
        } else if (['un', 'pc', 'cx'].includes(effectiveUnit)) {
            return qty % 1 === 0 ? qty.toString() : qty.toFixed(2);
        } else {
            return qty.toFixed(2);
        }
    }

    function getUnitLabel(unitOfMeasure) {
        if (!unitOfMeasure) return 'un';
        const unitMap = { 'un': 'un', 'kg': 'kg', 'g': 'g', 'ton': 'ton', 'pc': 'pc', 'cx': 'cx', 'l': 'l', 'ml': 'ml' };
        return unitMap[unitOfMeasure] || unitOfMeasure;
    }

    function getInputStep(unitOfMeasure) {
        if (!unitOfMeasure) return '0.01';
        if (['kg', 'g', 'ton', 'l', 'ml'].includes(unitOfMeasure)) return '0.01';
        if (['un', 'pc'].includes(unitOfMeasure)) return '1';
        if (unitOfMeasure === 'cx') return '0.5';
        return '0.01';
    }

    function getInputMin(unitOfMeasure) {
        if (!unitOfMeasure) return '0.01';
        return ['un', 'pc'].includes(unitOfMeasure) ? '1' : '0.01';
    }

    // --- Lógica Principal (Quando o HTML estiver pronto) ---
    document.addEventListener('DOMContentLoaded', () => {
        
        // --- Variáveis do Carrinho ---
        let cart = []; 
        let selectedItem = null;
        let debounceTimer;

        // --- Elementos do Formulário Principal ---
        const form = document.getElementById('requisition-form');
        const alertContainer = document.getElementById('alert-container');
        const btnAddToCart = document.getElementById('btn-add-item-to-cart');
        const cartTableBody = document.getElementById('cart-items-body');
        const selectedItemName = document.getElementById('selected-item-name');
        const selectedItemId = document.getElementById('selected-item-id');
        const selectedItemUnit = document.getElementById('selected-item-unit');
        const selectedItemQty = document.getElementById('search-item-qty');
        const quantityInfo = document.getElementById('quantity-info');
        
        // --- Elementos do Modal de Busca ---
        const btnOpenSearchModal = document.getElementById('btn-open-search-modal');
        const searchModal = document.getElementById('item-search-modal');
        const btnCloseSearchModal = document.getElementById('btn-close-search-modal');
        const searchInput = document.getElementById('item-search-input');
        const searchResultsContainer = document.getElementById('item-search-results');
        
        // --- Elementos dos Botões de Rádio (Justificativa / OP) ---
        const radioJustificativa = document.querySelector('input[name="requestType"][value="justificativa"]');
        const radioOP = document.querySelector('input[name="requestType"][value="op"]');
        const groupJustificativa = document.getElementById('justificativa-group');
        const groupOP = document.getElementById('op-group');
        const inputJustificativa = document.getElementById('justificativa');
        const inputOP = document.getElementById('op');

        // --- Função de Alerta ---
        function showAlert(message, isError = false) {
            alertContainer.innerHTML = `
                <div class="alert ${isError ? 'alert-danger' : 'alert-success'}" style="margin-bottom: 1.5rem;">
                    ${message}
                </div>
            `;
            window.scrollTo(0, 0);
        }

        // --- Funções do Modal de Busca ---
        const openSearchModal = () => {
            if (searchModal) {
                searchModal.style.display = 'flex';
                searchInput.focus();
                performSearch(); 
            }
        };
        const closeSearchModal = () => {
            if (searchModal) {
                searchModal.style.display = 'none';
                searchInput.value = '';
                searchResultsContainer.innerHTML = '';
            }
        };

        // --- Função de Seleção de Item ---
        function selectItem(item) {
            selectedItem = item;
            
            const unitLabel = getUnitLabel(item.unitOfMeasure);
            selectedItemName.value = `${item.name} (Disponível: ${formatQuantity(item.availableQuantity, item.unitOfMeasure)} ${unitLabel})`;
            selectedItemId.value = item.id;
            selectedItemUnit.value = item.unitOfMeasure || 'un';
            
            selectedItemQty.step = getInputStep(item.unitOfMeasure);
            selectedItemQty.min = getInputMin(item.unitOfMeasure);
            selectedItemQty.value = '';
            
            const unitClass = item.unitOfMeasure ? `unit-${item.unitOfMeasure}` : 'unit-un';
            quantityInfo.innerHTML = `Unidade: <span class="unit-badge ${unitClass}">${unitLabel}</span> | Disponível: <strong>${formatQuantity(item.availableQuantity, item.unitOfMeasure)}</strong>`;
            
            closeSearchModal();
            selectedItemQty.focus();
        }

        // --- Lógica de Busca (API) ---
        const performSearch = async () => {
            const query = searchInput.value;
            try {
                const response = await fetch(`/api/search-items?q=${query}`);
                const items = await response.json();
                searchResultsContainer.innerHTML = ''; 

                if (items.length > 0) {
                    items.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'result-item';
                        
                        const unitLabel = getUnitLabel(item.unitOfMeasure);
                        const unitClass = item.unitOfMeasure ? `unit-${item.unitOfMeasure}` : 'unit-un';
                        
                        div.innerHTML = `
                            <div>
                                <strong>${item.name}</strong>
                                <span>(Cód: ${item.code || 'N/A'})</span>
                                <span class="unit-badge ${unitClass}">${unitLabel}</span>
                            </div>
                            <span class="qty">Disponível: ${formatQuantity(item.availableQuantity, item.unitOfMeasure)} ${unitLabel}</span>
                        `;
                        
                        if (item.availableQuantity > 0) {
                            div.addEventListener('click', () => selectItem(item));
                        } else {
                            div.style.cursor = 'not-allowed';
                            div.style.opacity = '0.5';
                        }
                        searchResultsContainer.appendChild(div);
                    });
                } else {
                    searchResultsContainer.innerHTML = '<div class="result-item">Nenhum item encontrado.</div>';
                }
            } catch (err) {
                console.error('Erro na busca:', err);
                searchResultsContainer.innerHTML = '<div class="result-item">Erro ao buscar itens.</div>';
            }
        };

        // --- Lógica do Carrinho ---
        function renderCart() {
            if (cart.length === 0) {
                cartTableBody.innerHTML = '<tr><td colspan="3" style="text-align: center;">Nenhum item adicionado.</td></tr>';
                return;
            }
            
            cartTableBody.innerHTML = '';
            cart.forEach((item, index) => {
                const tr = document.createElement('tr');
                const unitLabel = getUnitLabel(item.unitOfMeasure);
                const unitClass = item.unitOfMeasure ? `unit-${item.unitOfMeasure}` : 'unit-un';
                
                tr.innerHTML = `
                    <td>
                        <strong>${item.name}</strong> 
                        <span class="cart-item-unit">(Cód: ${item.code})</span>
                        <span class="unit-badge ${unitClass}">${unitLabel}</span>
                    </td>
                    <td>${formatQuantity(item.quantity, item.unitOfMeasure)} ${unitLabel}</td>
                    <td>
                        <button type="button" class="action-btn danger btn-remove-from-cart" data-index="${index}">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </td>
                `;
                cartTableBody.appendChild(tr);
            });

            document.querySelectorAll('.btn-remove-from-cart').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    cart.splice(e.currentTarget.dataset.index, 1);
                    renderCart();
                });
            });
        }

        // --- Event Listeners (Onde o erro estava acontecendo) ---

        // Lógica dos Rádios (Justificativa / OP)
        if (radioJustificativa && radioOP) { // Verifica se os elementos existem
            radioJustificativa.addEventListener('change', () => {
                if (radioJustificativa.checked) {
                    groupJustificativa.style.display = 'block';
                    groupOP.style.display = 'none';
                    inputOP.value = '';
                }
            });

            radioOP.addEventListener('change', () => {
                if (radioOP.checked) {
                    groupJustificativa.style.display = 'none';
                    groupOP.style.display = 'block';
                    inputJustificativa.value = '';
                }
            });
        }

        // Lógica do Formulário (Submit)
        if (form) { // Verifica se o formulário existe
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (cart.length === 0) {
                    showAlert('Você não pode enviar uma requisição vazia.', true);
                    return;
                }

                const requestType = document.querySelector('input[name="requestType"]:checked').value;
                const justificativa = inputJustificativa.value;
                const op = inputOP.value;

                if (requestType === 'justificativa' && !justificativa.trim()) {
                    showAlert('Por favor, preencha a justificativa.', true);
                    return;
                }
                if (requestType === 'op' && !op.trim()) {
                    showAlert('Por favor, preencha o número da OP.', true);
                    return;
                }

                const dataToSend = {
                    requestType: requestType,
                    justificativa: justificativa,
                    op: op,
                    items: cart.map(item => ({ 
                        id: item.id, 
                        quantity: item.quantity 
                    }))
                };

                try {
                    const response = await fetch('/requisicoes', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(dataToSend)
                    });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.error);
                    window.location.href = result.redirectUrl;
                } catch (error) {
                    showAlert(error.message, true);
                }
            });
        }
        
        // Lógica de Adicionar ao Carrinho
        if (btnAddToCart) { // Verifica se o botão existe
            btnAddToCart.addEventListener('click', () => {
                const quantity = parseFloat(selectedItemQty.value);
                if (!selectedItem) {
                    showAlert('Por favor, busque e selecione um item.', true);
                    return;
                }
                if (!quantity || quantity <= 0) {
                    showAlert('Por favor, insira uma quantidade válida.', true);
                    return;
                }
                
                const unitLabel = getUnitLabel(selectedItem.unitOfMeasure);
                if (quantity > selectedItem.availableQuantity) {
                    showAlert(`Estoque insuficiente. Disponível: ${formatQuantity(selectedItem.availableQuantity, selectedItem.unitOfMeasure)} ${unitLabel}`, true);
                    return;
                }
                
                const existingItemIndex = cart.findIndex(item => item.id === selectedItem.id);
                if (existingItemIndex !== -1) {
                    cart[existingItemIndex].quantity += quantity;
                } else {
                    cart.push({
                        id: selectedItem.id,
                        name: selectedItem.name,
                        code: selectedItem.code,
                        unitOfMeasure: selectedItem.unitOfMeasure || 'un',
                        quantity: quantity
                    });
                }

                selectedItem = null;
                selectedItemName.value = '';
                selectedItemId.value = '';
                selectedItemUnit.value = '';
                selectedItemQty.value = '';
                quantityInfo.innerHTML = '';
                renderCart();
            });
        }

        // --- Event Listeners dos Modais (Corrigido) ---
        if (btnOpenSearchModal) { // Verifica se o botão existe
            btnOpenSearchModal.addEventListener('click', openSearchModal);
        }
        if (btnCloseSearchModal) { // Verifica se o botão existe
            btnCloseSearchModal.addEventListener('click', closeSearchModal);
        }
        if (searchModal) { // Verifica se o modal existe
            window.addEventListener('click', (e) => { if (e.target === searchModal) closeSearchModal(); });
        }
        if (searchInput) { // Verifica se o input existe
            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(performSearch, 300);
            });
        }
        
        // Validação de quantidade no input
        if (selectedItemQty) { // Verifica se o input existe
            selectedItemQty.addEventListener('input', () => {
                if (selectedItem) {
                    const quantity = parseFloat(selectedItemQty.value);
                    if (quantity > selectedItem.availableQuantity) {
                        selectedItemQty.style.borderColor = '#ef4444';
                    } else {
                        selectedItemQty.style.borderColor = '#d1d5db';
                    }
                }
            });
        }

    }); // Fim do DOMContentLoaded
</script>