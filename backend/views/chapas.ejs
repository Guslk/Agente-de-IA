<%- include('partials/header', { title: 'Controle de Chapas', paginaAtiva: 'chapas' }) %>

<!-- Removido o bloco <style> interno. Todo o estilo vem do style.css -->

<header class="header">
    <h1 class="header-title">Controle Geométrico de Chapas</h1>
    <div class="header-right">
        <!-- Ícone de notificação (opcional, manter se usado) -->
        <!--
        <div class="notification-icon">
            <i class="bi bi-bell-fill"></i>
            <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
                <span class="notification-badge"><%= lowStockCount %></span>
            <% } %>
        </div>
         -->
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.nome || user.name %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar" class="avatar-img">
            <% } %>
        </div>
    </div>
</header>

<main class="main-content">

    <div class="main-header">
        <!-- Título principal da seção -->
        <h2>Controle de Consumo de Chapas</h2>
        <div class="action-buttons">
            <!-- Botão de abrir modal -->
            <button id="open-modal-btn" class="btn-primary" style="background-color: var(--primary-color);">
                <i class="bi bi-plus-circle" style="margin-right: 8px;"></i> Cadastrar Nova Chapa
            </button>
        </div>
    </div>

    <!-- Painel de seleção e corte automático -->
    <div class="filter-section">
        <div class="filter-form"> <!-- Usando filter-form como div para layout flex -->

            <div class="form-group" style="flex-grow: 1.5;">
                <label for="plate-selector">Selecionar Chapa</label>
                <select id="plate-selector">
                    <option value="">-- Carregando chapas... --</option>
                    <!-- Opções carregadas via JS -->
                </select>
                <p id="plate-dimensions" style="margin-top: 5px; font-size: 0.85rem; color: var(--text-light);"></p>
            </div>

            <div class="form-group" style="flex-grow: 2;">
                <label>Adicionar Corte por Dimensão</label>
                <!-- Formulário interno preservado -->
                <form id="auto-cut-form" class="form-grid" style="grid-template-columns: 2fr 2fr 1fr; gap: 10px; margin-top: 5px;">
                    <input type="number" id="cut-width" placeholder="Largura (mm)" required>
                    <input type="number" id="cut-height" placeholder="Altura (mm)" required>
                    <!-- Botão Adicionar com estilo específico -->
                    <button type="submit" id="btn-add-cut-auto" class="btn-primary" style="background-color: #17a2b8; width: 100%; margin: 0; padding: 12px;">Adicionar</button>
                </form>
            </div>

        </div>
    </div>

    <!-- Container Flex para Canvas + Campos de Dimensão -->
    <div style="display: flex; gap: 20px; align-items: flex-start; margin-top: 20px;">

        <!-- Container do Canvas -->
        <!-- Usando report-card para borda e sombra -->
        <div class="report-card" style="flex-grow: 1; min-width: 0; padding: 15px;">
             <canvas id="canvas" style="display: block; width: 100%; height: auto; max-height: 65vh; border: 1px solid var(--border-color); background-color: #fff; cursor: crosshair; margin: 0 auto;"></canvas>
        </div>

        <!-- Campos para exibir as dimensões -->
        <div style="width: 150px; flex-shrink: 0;">
            <div class="form-group" style="margin-bottom: 15px;">
                <label for="current-cut-width">Largura Atual (mm)</label>
                <input type="text" id="current-cut-width" value="0.0" readonly style="text-align: right; background-color: #e9ecef;">
            </div>
            <div class="form-group">
                <label for="current-cut-height">Altura Atual (mm)</label>
                <input type="text" id="current-cut-height" value="0.0" readonly style="text-align: right; background-color: #e9ecef;">
            </div>
        </div>
    </div>

    <!-- Controles inferiores -->
    <div class="report-card" style="padding: 0; margin-top: 20px;"> <!-- Padding removido para alinhar com tabela -->
        <div style="display: flex; gap: 10px; padding: 15px; border-bottom: 1px solid var(--border-color);">
            <button id="btn-undo-cut" class="btn-secondary">Desfazer Último Corte</button>
            <button id="btn-save-cuts" class="btn-primary" style="background-color: var(--success);">Salvar Consumo na Chapa</button>
        </div>
        <p id="status-message" style="padding: 15px; margin: 0; color: var(--text-light); font-size: 0.9rem;">Para iniciar um corte, clique e arraste a partir de uma borda disponível.</p>
    </div>
</main>

<!-- Modal de Cadastro - Estrutura ajustada -->
<div id="new-plate-modal" class="modal-overlay">
    <div class="modal" style="max-width: 600px;">
        <div class="modal-header">
            <h3>Cadastrar Nova Chapa</h3>
            <button class="close-button" id="close-modal-btn">&times;</button>
        </div>

        <form id="new-plate-form">
            <div class="modal-body">
                 <!-- Grid simplificado para nome -->
                <div class="form-group">
                    <label for="plate-name">Nome/ID da Chapa</label>
                    <input type="text" id="plate-name" placeholder="Ex: Chapa Inox 304 2mm" required>
                </div>
                 <!-- Grid para dimensões -->
                <div class="form-grid">
                    <div class="form-group">
                        <label for="plate-width">Largura (mm)</label>
                        <input type="number" id="plate-width" placeholder="Ex: 3000" required min="1">
                    </div>
                    <div class="form-group">
                        <label for="plate-height">Altura (mm)</label>
                        <input type="number" id="plate-height" placeholder="Ex: 1500" required min="1">
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn-primary">Cadastrar Chapa</button>
            </div>
        </form>
    </div>
</div>


<%- include('partials/footer') %>

<!-- Script JS não precisa de alterações -->
<script src="/js/chapas-script.js"></script>

