

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurar 2FA | StockEx</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="auth-page">
    
    <div class="login-card">
        <div class="login-header">
            <h1><i class="bi bi-archive-fill"></i> StockEx</h1>
            <p>Para sua segurança, a verificação de duas etapas é obrigatória. Escaneie o QR code abaixo com seu app autenticador.</p>
        </div>

        <%# Bloco para exibir a mensagem de erro vinda do controller %>
        <% if (typeof error !== 'undefined' && error) { %>
            <p class="error-message"><%= error %></p>
        <% } %>
        
        <% if (qrCodeUrl) { %>
            <div style="text-align: center; margin: 25px 0;">
                <img src="<%= qrCodeUrl %>" alt="QR Code 2FA" style="max-width: 250px; border: 1px solid #e0e0e0; border-radius: 8px; padding: 10px; background: white;">
            </div>
            
            <form action="/setup-2fa" method="POST">
                <div class="form-group">
                    <label for="token">Insira o código de 6 dígitos</label>
                    <input type="text" name="token" id="token" required 
                           maxlength="6" pattern="\d{6}"
                           placeholder="000000"
                           autocomplete="off"
                           style="text-align: center; font-size: 1.2rem; letter-spacing: 0.3rem; font-weight: 600;">
                </div>
                <button type="submit" class="btn-login">Verificar e Finalizar Login</button>
            </form>
        <% } else { %>
            <div style="text-align: center; margin: 20px 0; padding: 20px; background: #f8f9fa; border-radius: 8px;">
                <p style="color: var(--text-light); margin-bottom: 15px;">Não foi possível gerar o QR code.</p>
                <a href="/setup-2fa" style="color: var(--primary-color); text-decoration: none; font-weight: 500;">Tente novamente</a>
            </div>
        <% } %>
    </div>

    <script>
        // Melhoria de UX para o campo de token
        document.addEventListener('DOMContentLoaded', function() {
            const tokenInput = document.getElementById('token');
            
            if (tokenInput) {
                // Foca automaticamente no campo
                tokenInput.focus();
                
                // Permite apenas números
                tokenInput.addEventListener('input', function(e) {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
                
                // Auto-submit quando completar 6 dígitos
                tokenInput.addEventListener('input', function(e) {
                    if (this.value.length === 6) {
                        this.form.submit();
                    }
                });
            }
        });
    </script>
</body>
</html>