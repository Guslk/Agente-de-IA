<%- include('partials/header', { title: 'Fornecedores', paginaAtiva: 'fornecedores' }) %>

<header class="header">
    <h1 class="header-title">Gerenciamento de Fornecedores</h1>
    <div class="header-right">
        <div class="notification-icon">
            <i class="bi bi-bell-fill"></i>
            <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
                <span class="notification-badge"><%= lowStockCount %></span>
            <% } %>
        </div>
        <div class="user-profile">
            <% if (typeof user !== 'undefined' && user) { %>
                <span>Bem-vindo, <%= user.nome %></span>
                <img src="https://i.pravatar.cc/40?u=<%= user.email %>" alt="Avatar">
            <% } %>
        </div>
        </div>
</header>

<main class="main-content">
    <div class="main-header">
        <h2>Fornecedores Cadastrados</h2>
        <div class="action-buttons">
            <button class="btn-entrada" id="btn-show-add-modal"><i class="bi bi-plus-circle-fill"></i> Adicionar Novo Fornecedor</button>
        </div>
    </div>
    <section class="inventory-table">
        <table>
            <thead>
                <tr>
                    <th>Empresa</th>
                    <th>Contato</th>
                    <th>Telefone / Email</th>
                    <th>Endereço</th> <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof fornecedores !== 'undefined' && fornecedores.length > 0) { %>
                    <% fornecedores.forEach(f => { %>
                        <tr>
                            <td><strong><%= f.nome_empresa %></strong></td>
                            <td><%= f.contato %></td>
                            <td><%= f.telefone %><br><%= f.email %></td>
                            <td><%= f.endereco %></td> <td>
                                <button title="Editar" class="action-btn btn-edit" data-fornecedor='<%= JSON.stringify(f) %>'>
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <form action="/fornecedores/excluir/<%= f.id_fornecedor %>" method="POST" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja excluir este fornecedor?');">
                                    <button type="submit" title="Excluir" class="action-btn danger">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="5" style="text-align: center;">Nenhum fornecedor encontrado.</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<div class="modal-overlay" id="add-modal">
    <div class="modal">
        <div class="modal-header"><h3>Adicionar Novo Fornecedor</h3><button class="close-button" id="btn-close-add-modal">&times;</button></div>
        <form action="/fornecedores/novo" method="POST">
            <div class="modal-body"><div class="form-grid">
                <div class="form-group"><label for="nome_empresa">Nome da Empresa</label><input type="text" id="nome_empresa" name="nome_empresa" required></div>
                <div class="form-group"><label for="contato">Nome do Contato</label><input type="text" id="contato" name="contato"></div>
                <div class="form-group"><label for="telefone">Telefone</label><input type="text" id="telefone" name="telefone"></div>
                <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email"></div>
                <div class="form-group" style="grid-column: 1 / -1;"><label for="endereco">Endereço</label><input type="text" id="endereco" name="endereco"></div>
            </div></div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Salvar Fornecedor</button></div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="edit-modal">
    <div class="modal">
        <div class="modal-header"><h3>Editar Fornecedor</h3><button class="close-button" id="btn-close-edit-modal">&times;</button></div>
        <form id="edit-form" method="POST">
            <div class="modal-body"><div class="form-grid">
                <div class="form-group"><label for="edit-nome_empresa">Nome da Empresa</label><input type="text" id="edit-nome_empresa" name="nome_empresa" required></div>
                <div class="form-group"><label for="edit-contato">Nome do Contato</label><input type="text" id="edit-contato" name="contato"></div>
                <div class="form-group"><label for="edit-telefone">Telefone</label><input type="text" id="edit-telefone" name="telefone"></div>
                <div class="form-group"><label for="edit-email">Email</label><input type="email" id="edit-email" name="email"></div>
                <div class="form-group" style="grid-column: 1 / -1;"><label for="edit-endereco">Endereço</label><input type="text" id="edit-endereco" name="endereco"></div>
            </div></div>
            <div class="modal-footer"><button type="submit" class="btn-primary">Salvar Alterações</button></div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Lógica para o modal de ADICIONAR
    const addModal = document.getElementById('add-modal');
    const btnShowAddModal = document.getElementById('btn-show-add-modal');
    const btnCloseAddModal = document.getElementById('btn-close-add-modal');
    if(btnShowAddModal) btnShowAddModal.addEventListener('click', () => addModal.style.display = 'flex');
    if(btnCloseAddModal) btnCloseAddModal.addEventListener('click', () => addModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === addModal) addModal.style.display = 'none'; });

    // Lógica para o modal de EDITAR
    const editModal = document.getElementById('edit-modal');
    const btnCloseEditModal = document.getElementById('btn-close-edit-modal');
    const editForm = document.getElementById('edit-form');
    const btnsEdit = document.querySelectorAll('.btn-edit');

    btnsEdit.forEach(btn => {
        btn.addEventListener('click', () => {
            const fornecedor = JSON.parse(btn.dataset.fornecedor);
            editForm.action = `/fornecedores/editar/${fornecedor.id_fornecedor}`;
            document.getElementById('edit-nome_empresa').value = fornecedor.nome_empresa;
            document.getElementById('edit-contato').value = fornecedor.contato;
            document.getElementById('edit-telefone').value = fornecedor.telefone;
            document.getElementById('edit-email').value = fornecedor.email;
            document.getElementById('edit-endereco').value = fornecedor.endereco;
            editModal.style.display = 'flex';
        });
    });
    if(btnCloseEditModal) btnCloseEditModal.addEventListener('click', () => editModal.style.display = 'none');
    window.addEventListener('click', (event) => { if (event.target === editModal) editModal.style.display = 'none'; });
});
</script>